//@version=6
indicator("支配波 1-2-3 エントリー", overlay = true, max_labels_count = 500)

int pivotBars = input.int(3, "スイング判定の左右本数", minval = 1, maxval = 20)
bool showPoints = input.bool(true, "成立した1・2・3を表示")

markPoint(int pointTime, float price, string caption, string labelStyle, color tint) =>
    label.new(pointTime, price, caption + "\n" + str.tostring(price, format.mintick),
         xloc = xloc.bar_time, style = labelStyle, color = tint, textcolor = color.white, size = size.small)

// 売りは価格の符号を反転し、同じ条件で判定する。
detectWave(bool isLong) =>
    float direction = isLong ? 1.0 : -1.0
    float upper = isLong ? high : -low
    float lower = isLong ? low : -high
    float settlement = direction * close
    float pivotTop = ta.pivothigh(upper, pivotBars, pivotBars)
    float pivotBottom = ta.pivotlow(lower, pivotBars, pivotBars)

    var float priorTop = na
    var int priorTopTime = na
    var float lastBottom = na
    var int lastBottomTime = na
    var float point1 = na
    var int point1Time = na
    var float point2 = na
    var int point2Time = na
    var float point3 = na
    var int point3Time = na
    bool entry = false
    float brokenLevel = na

    if barstate.isconfirmed
        int pivotTime = time[pivotBars]
        if not na(pivotTop)
            bool startsWave = na(point2) and not na(priorTop) and pivotTop > priorTop and
                 not na(lastBottomTime) and priorTopTime < lastBottomTime and lastBottomTime < pivotTime
            if startsWave
                point1 := lastBottom
                point1Time := lastBottomTime
                point2 := pivotTop
                point2Time := pivotTime
                point3 := na
                point3Time := na
                // 2の右側で既に確定した足を、古い順に取り込む。当足は下で判定する。
                if pivotBars > 1
                    for offset = pivotBars - 1 to 1
                        if na(point3) or lower[offset] < point3
                            point3 := lower[offset]
                            point3Time := time[offset]
            priorTop := pivotTop
            priorTopTime := pivotTime
        if not na(pivotBottom)
            lastBottom := pivotBottom
            lastBottomTime := pivotTime

        if not na(point2)
            if lower <= point1 or (not na(point3) and point3 <= point1)
                point2 := na
            else if settlement > point2
                if not na(point3) and point3 < point2
                    entry := true
                    brokenLevel := point2
                point2 := na
            else if na(point3) or lower < point3
                point3 := lower
                point3Time := time

    [entry, direction * point2, point1Time, direction * point1, point2Time, direction * brokenLevel,
         point3Time, direction * point3]

drawEntry(bool isLong, int t1, float p1, int t2, float p2, int t3, float p3) =>
    color tint = isLong ? color.teal : color.maroon
    string bottomStyle = isLong ? label.style_label_up : label.style_label_down
    string topStyle = isLong ? label.style_label_down : label.style_label_up
    if showPoints
        markPoint(t1, p1, "1", bottomStyle, tint)
        markPoint(t2, p2, "2", topStyle, tint)
        markPoint(t3, p3, "3", bottomStyle, tint)
    markPoint(time, close, isLong ? "BUY" : "SELL", bottomStyle, tint)

[buyBreak, buyLevel, buyT1, buyP1, buyT2, buyP2, buyT3, buyP3] = detectWave(true)
[sellBreak, sellLevel, sellT1, sellP1, sellT2, sellP2, sellT3, sellP3] = detectWave(false)

// 逆方向の支配波が当足の終値でも有効なら、その範囲内の小さな突破は表示しない。
bool buy = buyBreak and na(sellLevel) and not sellBreak
bool sell = sellBreak and na(buyLevel) and not buyBreak
if buy
    drawEntry(true, buyT1, buyP1, buyT2, buyP2, buyT3, buyP3)
if sell
    drawEntry(false, sellT1, sellP1, sellT2, sellP2, sellT3, sellP3)

plot(buyLevel, "買いの2番突破ライン", color.teal, 2, plot.style_linebr)
plot(sellLevel, "売りの2番突破ライン", color.maroon, 2, plot.style_linebr)
alertcondition(buy, "BUY 支配波", "{{ticker}} {{interval}} BUY {{close}}")
alertcondition(sell, "SELL 支配波", "{{ticker}} {{interval}} SELL {{close}}")

var int tradeSide = 0
var float entryPrice = na
var float stopPrice = na
var float targetPrice = na
var int wins = 0
var int losses = 0

if barstate.isconfirmed
    // 決済を先に判定するため、新規エントリー足の高安は決済に使わない。
    if tradeSide != 0
        bool longTrade = tradeSide == 1
        bool stopAtOpen = longTrade ? open <= stopPrice : open >= stopPrice
        bool targetAtOpen = longTrade ? open >= targetPrice : open <= targetPrice
        bool hitStop = longTrade ? low <= stopPrice : high >= stopPrice
        bool hitTarget = longTrade ? high >= targetPrice : low <= targetPrice
        if stopAtOpen or (hitStop and not targetAtOpen)
            losses += 1
            tradeSide := 0
        else if targetAtOpen or hitTarget
            wins += 1
            tradeSide := 0

    if tradeSide == 0 and (buy or sell)
        int side = buy ? 1 : -1
        float stop = buy ? buyP3 : sellP3
        int riskTicks = math.round(side * (close - stop) / syminfo.mintick)
        if riskTicks > 0
            tradeSide := side
            entryPrice := close
            stopPrice := stop
            int targetTicks = math.ceil(riskTicks * 13 / 10.0)
            targetPrice := math.round_to_mintick(close + side * targetTicks * syminfo.mintick)

plot(tradeSide != 0 ? entryPrice : na, "集計中のエントリー", color.gray, 1, plot.style_linebr)
plot(tradeSide != 0 ? stopPrice : na, "損切り 3番", color.red, 2, plot.style_linebr)
plot(tradeSide != 0 ? targetPrice : na, "利確 1.3R", color.lime, 2, plot.style_linebr)

var table stats = table.new(position.top_right, 1, 1)
if barstate.islast
    int closed = wins + losses
    string winRate = closed > 0 ? str.tostring(100.0 * wins / closed, "#.0") + "%" : "—"
    string summary = "RR 1:1.3  |  勝率 " + winRate +
         "\n決済 " + str.tostring(closed) + "  |  勝 " + str.tostring(wins) + "  負 " + str.tostring(losses) +
         "\n同時保有1件・コストなし"
    table.cell(stats, 0, 0, summary, text_color = color.white, bgcolor = color.rgb(32, 39, 54))
