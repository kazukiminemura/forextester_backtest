//@version=5
indicator("Yosuga × Tamukai Simple Entry MTF v3", overlay=true, shorttitle="Yosuga_Simple_MTF_v3", max_labels_count=500, max_lines_count=500, dynamic_requests=true)

// ==========================================
// 入力パラメータ
// ==========================================
gpDow = "【よすが式ダウ理論設定】"
leftBars = input.int(5, "高値・安値 検出期間 (左側)", minval=1, group=gpDow)
rightBars = input.int(5, "高値・安値 検出期間 (右側)", minval=1, group=gpDow)

gpHtf = "【確定上位足方向】"
useAutoHtf = input.bool(true, "チャート足に応じて上位足を自動選択", group=gpHtf)
manualHtfTimeframe = input.timeframe("240", "上位足 (自動選択OFF時)", group=gpHtf)
htfMaLength = input.int(20, "上位足SMA期間", minval=2, group=gpHtf)
requireDowAlignment = input.bool(true, "チャート足ダウ方向の一致を必須にする", group=gpHtf)

gpEntry = "【田向式 押し目・戻り設定】"
maLength = input.int(20, "押し目・戻りSMA期間", minval=2, group=gpEntry)
setupWaitBars = input.int(4, "接触後のブレイク待機本数", minval=1, maxval=16, group=gpEntry)
closeLocationThreshold = input.float(0.65, "反転足の終値位置", minval=0.5, maxval=0.9, step=0.05, group=gpEntry)
requireMaSlope = input.bool(true, "チャート足SMAの傾き一致を必須にする", group=gpEntry)

gpRisk = "【RR1・建値撤退】"
atrLength = input.int(14, "ATR期間", minval=1, group=gpRisk)
structureBufferAtr = input.float(0.1, "構造SLのATRバッファ", minval=0.0, step=0.05, group=gpRisk)
enableBreakeven = input.bool(true, "建値撤退を有効にする", group=gpRisk)
breakevenTriggerR = input.float(0.5, "建値移動を有効にするR", minval=0.1, maxval=0.9, step=0.05, group=gpRisk)
roundTripCostPct = input.float(0.01, "1取引の往復コスト (%)", minval=0.0, step=0.01, group=gpRisk)

gpScanner = "【時間足別 エントリーチャンス】"
showOpportunityScanner = input.bool(true, "5分〜日足のチャンス一覧を表示", group=gpScanner)

// スキャナーは各時間足の1本前の確定足を参照します。
fScannerDowTrend() =>
    float scannerPivotHigh = ta.pivothigh(high, leftBars, rightBars)
    float scannerPivotLow = ta.pivotlow(low, leftBars, rightBars)
    var float scannerLastHigh = na
    var float scannerLastLow = na
    var int scannerTrend = 0
    if not na(scannerPivotHigh)
        scannerLastHigh := scannerPivotHigh
    if not na(scannerPivotLow)
        scannerLastLow := scannerPivotLow
    bool scannerCrossUp = ta.crossover(close, scannerLastHigh)
    bool scannerCrossDown = ta.crossunder(close, scannerLastLow)
    if not na(scannerLastHigh) and scannerCrossUp and scannerTrend <= 0
        scannerTrend := 1
    if not na(scannerLastLow) and scannerCrossDown and scannerTrend >= 0
        scannerTrend := -1
    scannerTrend

// 2/-2 = ブレイク確認、1/-1 = MA接触後の反発・反落待ち、0 = 接触待ち。
fScannerPullbackState() =>
    float scannerMa = ta.sma(close, maLength)
    float scannerRange = high - low
    float scannerLongCloseLocation = scannerRange > 0 ? (close - low) / scannerRange : 0.5
    float scannerShortCloseLocation = 1.0 - scannerLongCloseLocation
    bool scannerLongTouch = low[1] > scannerMa[1] and low <= scannerMa and close >= scannerMa and scannerLongCloseLocation >= closeLocationThreshold
    bool scannerShortTouch = high[1] < scannerMa[1] and high >= scannerMa and close <= scannerMa and scannerShortCloseLocation >= closeLocationThreshold
    int scannerLongAge = ta.barssince(scannerLongTouch)
    int scannerShortAge = ta.barssince(scannerShortTouch)
    bool scannerLongRecent = not na(scannerLongAge) and scannerLongAge <= setupWaitBars
    bool scannerShortRecent = not na(scannerShortAge) and scannerShortAge <= setupWaitBars
    bool scannerLongSlopeOk = not requireMaSlope or scannerMa > scannerMa[1]
    bool scannerShortSlopeOk = not requireMaSlope or scannerMa < scannerMa[1]
    bool scannerLongBreak = scannerLongRecent and scannerLongSlopeOk and close > high[1] and close > scannerMa
    bool scannerShortBreak = scannerShortRecent and scannerShortSlopeOk and close < low[1] and close < scannerMa
    scannerLongBreak ? 2 : scannerShortBreak ? -2 : scannerLongRecent and close >= scannerMa ? 1 : scannerShortRecent and close <= scannerMa ? -1 : 0

fScannerHtfDirection(float completedMa, float previousMa) =>
    completedMa > previousMa ? 1 : completedMa < previousMa ? -1 : 0

fScannerDirectionText(int htfDirection, int localDow) =>
    htfDirection == 1 and (not requireDowAlignment or localDow == 1) ? "↑ 一致" : htfDirection == -1 and (not requireDowAlignment or localDow == -1) ? "↓ 一致" : htfDirection == 0 ? "横ばい" : "不一致"

fScannerChanceText(int htfDirection, int localDow, int pullbackState) =>
    bool scannerLongAllowed = htfDirection == 1 and (not requireDowAlignment or localDow == 1)
    bool scannerShortAllowed = htfDirection == -1 and (not requireDowAlignment or localDow == -1)
    scannerLongAllowed ? (pullbackState == 2 ? "BUY候補" : pullbackState == 1 ? "反発待ち" : "押し目待ち") : scannerShortAllowed ? (pullbackState == -2 ? "SELL候補" : pullbackState == -1 ? "反落待ち" : "戻り待ち") : "方向待ち"

fScannerChanceColor(int htfDirection, int localDow, int pullbackState) =>
    bool scannerLongAllowed = htfDirection == 1 and (not requireDowAlignment or localDow == 1)
    bool scannerShortAllowed = htfDirection == -1 and (not requireDowAlignment or localDow == -1)
    scannerLongAllowed and pullbackState == 2 ? color.lime : scannerShortAllowed and pullbackState == -2 ? color.orange : (scannerLongAllowed and pullbackState == 1) or (scannerShortAllowed and pullbackState == -1) ? color.yellow : scannerLongAllowed ? color.aqua : scannerShortAllowed ? color.rgb(255, 120, 80) : color.silver

fScannerDisplayText(int htfDirection, int localDow, int pullbackState, bool isChartTimeframe, int activeTradeDirection) =>
    bool isEntryTimeframe = isChartTimeframe and activeTradeDirection != 0
    isEntryTimeframe ? (activeTradeDirection == 1 ? "BUY エントリー中" : "SELL エントリー中") : fScannerChanceText(htfDirection, localDow, pullbackState)

fScannerDisplayColor(int htfDirection, int localDow, int pullbackState, bool isChartTimeframe, int activeTradeDirection) =>
    bool isEntryTimeframe = isChartTimeframe and activeTradeDirection != 0
    isEntryTimeframe ? (activeTradeDirection == 1 ? color.blue : color.orange) : color.new(fScannerChanceColor(htfDirection, localDow, pullbackState), 25)

fScannerDisplayTextColor(bool isChartTimeframe, int activeTradeDirection) =>
    isChartTimeframe and activeTradeDirection != 0 ? color.white : color.black

[scannerDow5m, scannerPullback5m] = request.security(syminfo.tickerid, "5", [fScannerDowTrend()[1], fScannerPullbackState()[1]], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
[scannerDow15m, scannerPullback15m] = request.security(syminfo.tickerid, "15", [fScannerDowTrend()[1], fScannerPullbackState()[1]], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
[scannerDow1h, scannerPullback1h] = request.security(syminfo.tickerid, "60", [fScannerDowTrend()[1], fScannerPullbackState()[1]], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
[scannerDow4h, scannerPullback4h] = request.security(syminfo.tickerid, "240", [fScannerDowTrend()[1], fScannerPullbackState()[1]], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
[scannerDow1d, scannerPullback1d] = request.security(syminfo.tickerid, "D", [fScannerDowTrend()[1], fScannerPullbackState()[1]], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

[scanner1hMa, scanner1hMaPrevious] = request.security(syminfo.tickerid, "60", [ta.sma(close, htfMaLength)[1], ta.sma(close, htfMaLength)[2]], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
[scanner4hMa, scanner4hMaPrevious] = request.security(syminfo.tickerid, "240", [ta.sma(close, htfMaLength)[1], ta.sma(close, htfMaLength)[2]], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
[scanner1dMa, scanner1dMaPrevious] = request.security(syminfo.tickerid, "D", [ta.sma(close, htfMaLength)[1], ta.sma(close, htfMaLength)[2]], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
[scanner1wMa, scanner1wMaPrevious] = request.security(syminfo.tickerid, "W", [ta.sma(close, htfMaLength)[1], ta.sma(close, htfMaLength)[2]], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

int scannerHtf5m = fScannerHtfDirection(scanner1hMa, scanner1hMaPrevious)
int scannerHtf15m = fScannerHtfDirection(scanner4hMa, scanner4hMaPrevious)
int scannerHtf1h = scannerHtf15m
int scannerHtf4h = fScannerHtfDirection(scanner1dMa, scanner1dMaPrevious)
int scannerHtf1d = fScannerHtfDirection(scanner1wMa, scanner1wMaPrevious)

// ==========================================
// よすが式: 確定スイングとチャート足ダウ方向
// ==========================================
pH = ta.pivothigh(high, leftBars, rightBars)
pL = ta.pivotlow(low, leftBars, rightBars)

var float lastHigh = na
var float lastLow = na

if not na(pH)
    lastHigh := pH
if not na(pL)
    lastLow := pL

var int dowTrend = 0
bool crossedAboveLastHigh = ta.crossover(close, lastHigh)
bool crossedBelowLastLow = ta.crossunder(close, lastLow)
bool dowTurnedUp = not na(lastHigh) and crossedAboveLastHigh and dowTrend <= 0
bool dowTurnedDown = not na(lastLow) and crossedBelowLastLow and dowTrend >= 0

if dowTurnedUp
    dowTrend := 1
if dowTurnedDown
    dowTrend := -1

// ==========================================
// 対応チャート足と確定した上位足
// 自動: 5分→1時間、15分→4時間、1時間→4時間、4時間→日足、日足→週足
// [1] と [2] により形成中の上位足を方向判定に使いません。
// ==========================================
bool isFiveMinuteChart = timeframe.isminutes and timeframe.multiplier == 5
bool isFifteenMinuteChart = timeframe.isminutes and timeframe.multiplier == 15
bool isOneHourChart = timeframe.isminutes and timeframe.multiplier == 60
bool isFourHourChart = timeframe.isminutes and timeframe.multiplier == 240
bool isOneDayChart = timeframe.isdaily and timeframe.multiplier == 1
bool isSupportedChart = isFiveMinuteChart or isFifteenMinuteChart or isOneHourChart or isFourHourChart or isOneDayChart
string autoHtfTimeframe = isFiveMinuteChart ? "60" : isFifteenMinuteChart ? "240" : isOneHourChart ? "240" : isFourHourChart ? "D" : isOneDayChart ? "W" : manualHtfTimeframe
string effectiveHtfTimeframe = useAutoHtf ? autoHtfTimeframe : manualHtfTimeframe
bool isHigherTimeframeValid = timeframe.in_seconds(effectiveHtfTimeframe) > timeframe.in_seconds(timeframe.period)
string chartTimeframeName = isFiveMinuteChart ? "5分" : isFifteenMinuteChart ? "15分" : isOneHourChart ? "1時間" : isFourHourChart ? "4時間" : isOneDayChart ? "日足" : timeframe.period
string htfTimeframeName = effectiveHtfTimeframe == "60" ? "1時間" : effectiveHtfTimeframe == "240" ? "4時間" : effectiveHtfTimeframe == "D" ? "日足" : effectiveHtfTimeframe == "W" ? "週足" : effectiveHtfTimeframe
float entryMa = ta.sma(close, maLength)
float atrValue = ta.atr(atrLength)
completedHtfMa = request.security(syminfo.tickerid, effectiveHtfTimeframe, ta.sma(close, htfMaLength)[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
previousCompletedHtfMa = request.security(syminfo.tickerid, effectiveHtfTimeframe, ta.sma(close, htfMaLength)[2], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
bool htfLong = completedHtfMa > previousCompletedHtfMa
bool htfShort = completedHtfMa < previousCompletedHtfMa
bool longDirectionAllowed = isHigherTimeframeValid and htfLong and (not requireDowAlignment or dowTrend == 1)
bool shortDirectionAllowed = isHigherTimeframeValid and htfShort and (not requireDowAlignment or dowTrend == -1)

// ==========================================
// 押し目・戻りの状態
// 1. トレンド側からMA20へ初回接触
// 2. 接触足がトレンド側へ戻って確定
// 3. 後続足が直前高値・安値を終値で突破
// ==========================================
var int armedDirection = 0
var int armedBar = na
var float armedExtreme = na

var int tradeDirection = 0
var int entryBar = na
var float entryPrice = na
var float stopPrice = na
var float targetPrice = na
var float breakevenTriggerPrice = na
var bool breakevenActive = false

var line activeEntryLine = na
var line activeTargetLine = na
var line activeStopLine = na
var label timeframeWarning = na

var int closedTrades = 0
var int wins = 0
var int losses = 0
var int breakevens = 0
var float totalReturnPct = 0.0
var float grossProfitPct = 0.0
var float grossLossPct = 0.0

bool longEntrySignal = false
bool shortEntrySignal = false

// 保有中は同一足でSLとTPの両方に触れた場合、保守的にSLを優先します。
if tradeDirection != 0 and bar_index > entryBar
    float effectiveStop = breakevenActive ? entryPrice : stopPrice
    bool stopHit = tradeDirection == 1 ? low <= effectiveStop : high >= effectiveStop
    bool targetHit = tradeDirection == 1 ? high >= targetPrice : low <= targetPrice
    bool triggerHit = tradeDirection == 1 ? high >= breakevenTriggerPrice : low <= breakevenTriggerPrice
    float exitPrice = na
    string exitName = ""
    color exitColor = color.gray

    if stopHit
        exitPrice := effectiveStop
        exitName := breakevenActive ? "建値撤退" : "損切"
        exitColor := breakevenActive ? color.gray : color.red
    else if targetHit
        exitPrice := targetPrice
        exitName := "利確 1R"
        exitColor := color.green
    else if enableBreakeven and not breakevenActive and triggerHit
        // 足の中の値動き順を推測せず、建値SLは次の足から有効にします。
        breakevenActive := true
        line.set_y1(activeStopLine, entryPrice)
        line.set_y2(activeStopLine, entryPrice)
        line.set_color(activeStopLine, color.gray)
        label.new(bar_index, entryPrice, "建値\n" + str.tostring(entryPrice, format.mintick), xloc=xloc.bar_index, yloc=yloc.price, style=tradeDirection == 1 ? label.style_label_up : label.style_label_down, color=color.gray, textcolor=color.white, size=size.small)

    if not na(exitPrice)
        float tradeReturnPct = tradeDirection * (exitPrice - entryPrice) / entryPrice * 100.0 - roundTripCostPct
        string returnPrefix = tradeReturnPct > 0 ? "+" : ""
        string directionName = tradeDirection == 1 ? "ロング" : "ショート"
        label.new(bar_index, exitPrice, directionName + " " + exitName + "\n決済: " + str.tostring(exitPrice, format.mintick) + "\n損益: " + returnPrefix + str.tostring(tradeReturnPct, "#.##") + "%", xloc=xloc.bar_index, yloc=yloc.price, style=tradeDirection == 1 ? label.style_label_down : label.style_label_up, color=exitColor, textcolor=color.white, size=size.small)
        closedTrades := closedTrades + 1
        totalReturnPct := totalReturnPct + tradeReturnPct
        if exitName == "建値撤退"
            breakevens := breakevens + 1
            grossLossPct := grossLossPct + math.abs(tradeReturnPct)
        else if tradeReturnPct > 0
            wins := wins + 1
            grossProfitPct := grossProfitPct + tradeReturnPct
        else
            losses := losses + 1
            grossLossPct := grossLossPct + math.abs(tradeReturnPct)
        line.set_x2(activeEntryLine, bar_index)
        line.set_x2(activeTargetLine, bar_index)
        line.set_x2(activeStopLine, bar_index)
        tradeDirection := 0
        entryBar := na
        entryPrice := na
        stopPrice := na
        targetPrice := na
        breakevenTriggerPrice := na
        breakevenActive := false
        armedDirection := 0
        armedBar := na
        armedExtreme := na

if tradeDirection != 0
    line.set_x2(activeEntryLine, bar_index)
    line.set_x2(activeTargetLine, bar_index)
    line.set_x2(activeStopLine, bar_index)

if isSupportedChart and isHigherTimeframeValid and tradeDirection == 0 and not na(entryMa) and not na(atrValue)
    if armedDirection != 0
        int setupAge = bar_index - armedBar
        bool directionStillValid = armedDirection == 1 ? longDirectionAllowed : shortDirectionAllowed
        if setupAge > setupWaitBars or not directionStillValid
            armedDirection := 0
            armedBar := na
            armedExtreme := na
        else if setupAge >= 1
            armedExtreme := armedDirection == 1 ? math.min(armedExtreme, low) : math.max(armedExtreme, high)
            bool maSlopeOk = not requireMaSlope or (armedDirection == 1 ? entryMa > entryMa[1] : entryMa < entryMa[1])
            bool priceBreakConfirmed = armedDirection == 1 ? close > high[1] : close < low[1]
            bool correctMaSide = armedDirection == 1 ? close > entryMa : close < entryMa
            if maSlopeOk and priceBreakConfirmed and correctMaSide
                float proposedStop = armedExtreme - armedDirection * atrValue * structureBufferAtr
                float riskDistance = armedDirection * (close - proposedStop)
                if riskDistance > syminfo.mintick
                    tradeDirection := armedDirection
                    entryBar := bar_index
                    entryPrice := close
                    stopPrice := proposedStop
                    targetPrice := entryPrice + tradeDirection * riskDistance
                    breakevenTriggerPrice := entryPrice + tradeDirection * riskDistance * breakevenTriggerR
                    breakevenActive := false
                    activeEntryLine := line.new(bar_index, entryPrice, bar_index, entryPrice, color=color.yellow, width=2)
                    activeTargetLine := line.new(bar_index, targetPrice, bar_index, targetPrice, color=color.lime, width=2)
                    activeStopLine := line.new(bar_index, stopPrice, bar_index, stopPrice, color=color.red, width=2)
                    string entryName = tradeDirection == 1 ? "押し目BUY" : "戻りSELL"
                    label.new(bar_index, entryPrice, entryName + "\nEntry: " + str.tostring(entryPrice, format.mintick) + "\nTP: " + str.tostring(targetPrice, format.mintick) + "\nSL: " + str.tostring(stopPrice, format.mintick), xloc=xloc.bar_index, yloc=yloc.price, style=tradeDirection == 1 ? label.style_label_up : label.style_label_down, color=tradeDirection == 1 ? color.blue : color.orange, textcolor=color.white, size=size.small)
                    longEntrySignal := tradeDirection == 1
                    shortEntrySignal := tradeDirection == -1
                    armedDirection := 0
                    armedBar := na
                    armedExtreme := na

    if armedDirection == 0 and tradeDirection == 0 and not na(entryMa[1])
        float candleRange = high - low
        float longCloseLocation = candleRange > 0 ? (close - low) / candleRange : 0.5
        float shortCloseLocation = 1.0 - longCloseLocation
        bool longTouch = longDirectionAllowed and low[1] > entryMa[1] and low <= entryMa and close >= entryMa and longCloseLocation >= closeLocationThreshold
        bool shortTouch = shortDirectionAllowed and high[1] < entryMa[1] and high >= entryMa and close <= entryMa and shortCloseLocation >= closeLocationThreshold
        if longTouch
            armedDirection := 1
            armedBar := bar_index
            armedExtreme := low
        else if shortTouch
            armedDirection := -1
            armedBar := bar_index
            armedExtreme := high

alertcondition(longEntrySignal, "押し目BUY", "押し目BUYエントリーしました")
alertcondition(shortEntrySignal, "戻りSELL", "戻りSELLエントリーしました")

// ==========================================
// 成績表示
// ==========================================
// 勝率では、損失を回避できた建値撤退も勝ちとして数えます。
// 損益・PFでは往復コストを残し、成績を過大評価しないようにします。
int winsIncludingBreakeven = wins + breakevens
float winRate = closedTrades > 0 ? winsIncludingBreakeven * 100.0 / closedTrades : na
float expectancyPct = closedTrades > 0 ? totalReturnPct / closedTrades : na
float averageWinPct = wins > 0 ? grossProfitPct / wins : na
float averageLossPct = losses > 0 ? grossLossPct / losses : na
float profitFactor = grossLossPct > 0 ? grossProfitPct / grossLossPct : na
float unrealizedPct = tradeDirection == 1 and not na(entryPrice) ? (close - entryPrice) / entryPrice * 100.0 : tradeDirection == -1 and not na(entryPrice) ? (entryPrice - close) / entryPrice * 100.0 : na

fPercent(float value) =>
    na(value) ? "--" : str.tostring(value, "#.##") + "%"

fNumber(float value) =>
    na(value) ? "--" : str.tostring(value, "#.##")

fValueColor(float value) =>
    na(value) ? color.silver : value > 0 ? color.lime : value < 0 ? color.red : color.white

var table statsTable = table.new(position.bottom_right, 2, 13, bgcolor=color.new(color.black, 5), border_width=2, frame_width=2, frame_color=color.orange)
var table opportunityTable = table.new(position.top_right, 3, 6, bgcolor=color.new(color.black, 5), border_width=2, frame_width=2, frame_color=color.aqua)

if barstate.islast
    if showOpportunityScanner
        color scannerHeader = color.rgb(25, 95, 165)
        color scannerTfBg = color.rgb(45, 50, 60)
        table.cell(opportunityTable, 0, 0, "時間足", bgcolor=scannerHeader, text_color=color.white)
        table.cell(opportunityTable, 1, 0, "上位足 / ダウ", bgcolor=scannerHeader, text_color=color.white)
        table.cell(opportunityTable, 2, 0, "エントリーチャンス", bgcolor=scannerHeader, text_color=color.white)
        table.cell(opportunityTable, 0, 1, "5分", bgcolor=isFiveMinuteChart ? color.blue : scannerTfBg, text_color=color.white)
        table.cell(opportunityTable, 1, 1, fScannerDirectionText(scannerHtf5m, scannerDow5m), bgcolor=color.new(fScannerChanceColor(scannerHtf5m, scannerDow5m, 0), 70), text_color=color.white)
        table.cell(opportunityTable, 2, 1, fScannerDisplayText(scannerHtf5m, scannerDow5m, scannerPullback5m, isFiveMinuteChart, tradeDirection), bgcolor=fScannerDisplayColor(scannerHtf5m, scannerDow5m, scannerPullback5m, isFiveMinuteChart, tradeDirection), text_color=fScannerDisplayTextColor(isFiveMinuteChart, tradeDirection))
        table.cell(opportunityTable, 0, 2, "15分", bgcolor=isFifteenMinuteChart ? color.blue : scannerTfBg, text_color=color.white)
        table.cell(opportunityTable, 1, 2, fScannerDirectionText(scannerHtf15m, scannerDow15m), bgcolor=color.new(fScannerChanceColor(scannerHtf15m, scannerDow15m, 0), 70), text_color=color.white)
        table.cell(opportunityTable, 2, 2, fScannerDisplayText(scannerHtf15m, scannerDow15m, scannerPullback15m, isFifteenMinuteChart, tradeDirection), bgcolor=fScannerDisplayColor(scannerHtf15m, scannerDow15m, scannerPullback15m, isFifteenMinuteChart, tradeDirection), text_color=fScannerDisplayTextColor(isFifteenMinuteChart, tradeDirection))
        table.cell(opportunityTable, 0, 3, "1時間", bgcolor=isOneHourChart ? color.blue : scannerTfBg, text_color=color.white)
        table.cell(opportunityTable, 1, 3, fScannerDirectionText(scannerHtf1h, scannerDow1h), bgcolor=color.new(fScannerChanceColor(scannerHtf1h, scannerDow1h, 0), 70), text_color=color.white)
        table.cell(opportunityTable, 2, 3, fScannerDisplayText(scannerHtf1h, scannerDow1h, scannerPullback1h, isOneHourChart, tradeDirection), bgcolor=fScannerDisplayColor(scannerHtf1h, scannerDow1h, scannerPullback1h, isOneHourChart, tradeDirection), text_color=fScannerDisplayTextColor(isOneHourChart, tradeDirection))
        table.cell(opportunityTable, 0, 4, "4時間", bgcolor=isFourHourChart ? color.blue : scannerTfBg, text_color=color.white)
        table.cell(opportunityTable, 1, 4, fScannerDirectionText(scannerHtf4h, scannerDow4h), bgcolor=color.new(fScannerChanceColor(scannerHtf4h, scannerDow4h, 0), 70), text_color=color.white)
        table.cell(opportunityTable, 2, 4, fScannerDisplayText(scannerHtf4h, scannerDow4h, scannerPullback4h, isFourHourChart, tradeDirection), bgcolor=fScannerDisplayColor(scannerHtf4h, scannerDow4h, scannerPullback4h, isFourHourChart, tradeDirection), text_color=fScannerDisplayTextColor(isFourHourChart, tradeDirection))
        table.cell(opportunityTable, 0, 5, "日足", bgcolor=isOneDayChart ? color.blue : scannerTfBg, text_color=color.white)
        table.cell(opportunityTable, 1, 5, fScannerDirectionText(scannerHtf1d, scannerDow1d), bgcolor=color.new(fScannerChanceColor(scannerHtf1d, scannerDow1d, 0), 70), text_color=color.white)
        table.cell(opportunityTable, 2, 5, fScannerDisplayText(scannerHtf1d, scannerDow1d, scannerPullback1d, isOneDayChart, tradeDirection), bgcolor=fScannerDisplayColor(scannerHtf1d, scannerDow1d, scannerPullback1d, isOneDayChart, tradeDirection), text_color=fScannerDisplayTextColor(isOneDayChart, tradeDirection))
    else
        table.clear(opportunityTable, 0, 0, 2, 5)

if barstate.islast
    color headerColor = color.rgb(25, 95, 165)
    color labelColor = color.rgb(45, 50, 60)
    color valueColor = color.rgb(15, 18, 24)
    string setupState = tradeDirection != 0 ? "保有中" : armedDirection == 1 ? "押し目待機" : armedDirection == -1 ? "戻り待機" : "待機"
    table.cell(statsTable, 0, 0, "Yosuga × Tamukai MTF", bgcolor=headerColor, text_color=color.white)
    table.cell(statsTable, 1, 0, "押し目・戻り RR1", bgcolor=headerColor, text_color=color.white)
    table.cell(statsTable, 0, 1, "チャート / 上位足", bgcolor=labelColor, text_color=color.white)
    table.cell(statsTable, 1, 1, chartTimeframeName + " / " + htfTimeframeName, bgcolor=valueColor, text_color=isHigherTimeframeValid ? color.white : color.red)
    table.cell(statsTable, 0, 2, "確定上位足方向", bgcolor=labelColor, text_color=color.white)
    table.cell(statsTable, 1, 2, htfLong ? "上昇" : htfShort ? "下降" : "横ばい", bgcolor=valueColor, text_color=htfLong ? color.lime : htfShort ? color.red : color.silver)
    table.cell(statsTable, 0, 3, "チャート足ダウ", bgcolor=labelColor, text_color=color.white)
    table.cell(statsTable, 1, 3, dowTrend == 1 ? "上昇" : dowTrend == -1 ? "下降" : "未確定", bgcolor=valueColor, text_color=dowTrend == 1 ? color.lime : dowTrend == -1 ? color.red : color.silver)
    table.cell(statsTable, 0, 4, "状態", bgcolor=labelColor, text_color=color.white)
    table.cell(statsTable, 1, 4, setupState, bgcolor=valueColor, text_color=color.white)
    table.cell(statsTable, 0, 5, "決済済み", bgcolor=labelColor, text_color=color.white)
    table.cell(statsTable, 1, 5, str.tostring(closedTrades), bgcolor=valueColor, text_color=color.white)
    table.cell(statsTable, 0, 6, "利確 / 損切 / 建値", bgcolor=labelColor, text_color=color.white)
    table.cell(statsTable, 1, 6, str.tostring(wins) + " / " + str.tostring(losses) + " / " + str.tostring(breakevens), bgcolor=valueColor, text_color=color.white)
    table.cell(statsTable, 0, 7, "勝率 (建値含む)", bgcolor=labelColor, text_color=color.white)
    table.cell(statsTable, 1, 7, fPercent(winRate), bgcolor=valueColor, text_color=fValueColor(winRate - 50.0))
    table.cell(statsTable, 0, 8, "期待値 / 取引", bgcolor=labelColor, text_color=color.white)
    table.cell(statsTable, 1, 8, fPercent(expectancyPct), bgcolor=valueColor, text_color=fValueColor(expectancyPct))
    table.cell(statsTable, 0, 9, "平均利益 / 平均損失", bgcolor=labelColor, text_color=color.white)
    table.cell(statsTable, 1, 9, fPercent(averageWinPct) + " / " + fPercent(averageLossPct), bgcolor=valueColor, text_color=color.white)
    table.cell(statsTable, 0, 10, "PF", bgcolor=labelColor, text_color=color.white)
    table.cell(statsTable, 1, 10, fNumber(profitFactor), bgcolor=valueColor, text_color=fValueColor(profitFactor - 1.0))
    table.cell(statsTable, 0, 11, "累計損益 (単純合計)", bgcolor=labelColor, text_color=color.white)
    table.cell(statsTable, 1, 11, fPercent(totalReturnPct), bgcolor=valueColor, text_color=fValueColor(totalReturnPct))
    table.cell(statsTable, 0, 12, "保有中の含み損益", bgcolor=labelColor, text_color=color.white)
    table.cell(statsTable, 1, 12, fPercent(unrealizedPct), bgcolor=valueColor, text_color=fValueColor(unrealizedPct))

if barstate.islast
    if not isSupportedChart or not isHigherTimeframeValid
        string warningText = not isSupportedChart ? "対応足: 5分 / 15分 / 1時間 / 4時間 / 日足" : "上位足はチャート足より長く設定してください"
        if na(timeframeWarning)
            timeframeWarning := label.new(bar_index, high, warningText, style=label.style_label_down, color=color.red, textcolor=color.white)
        else
            label.set_xy(timeframeWarning, bar_index, high)
            label.set_text(timeframeWarning, warningText)
    else if not na(timeframeWarning)
        label.delete(timeframeWarning)
        timeframeWarning := na
