//@version=6
indicator("BB ±3σ 文脈フィルター・PFインジケーター", overlay=true, max_labels_count=500, max_lines_count=10)

// User-described proxy, not authenticated WEMOF or broker-emulator results.
// Fixed-size pips simulation: confirmed signals enter at the next available open.
string gb = "BBと候補化"
int length = input.int(20, "BB期間", minval=2, group=gb)
float sigma = input.float(3.0, "標準偏差倍率", minval=0.5, step=0.1, group=gb)
int expiry = input.int(3, "準備の有効本数（タッチの次足から）", minval=1, maxval=20, group=gb)
bool requireReturn = input.bool(true, "候補化にはバンド内への終値回帰を要求（補助仮定）", group=gb)
float minCenterPips = input.float(3.0, "候補終値から中央線までの最低幅（pips・コスト控除前）", minval=0, step=0.1, group=gb)
bool restrictChart = input.bool(true, "5分足に限定（通貨ペア制限なし）", group=gb)

string gu = "銘柄別の価格単位"
bool autoPip = input.bool(true, "FXのpip幅を自動設定（JPY決済通貨＝0.01、その他＝0.0001）", group=gu)
float manualPip = input.float(0.01, "手動：1 pipの価格幅（自動OFF時）", minval=0.00000001, group=gu)
bool unitOK = not autoPip or syminfo.type == "forex"
float pipSize = autoPip ? (syminfo.currency == "JPY" ? 0.01 : 0.0001) : manualPip

string gf = "説明可能な動きの代理フィルター"
bool excludeBreak = input.bool(true, "直近高安を勢いよく突破したら見送り", group=gf)
int lookback = input.int(12, "高安参照本数（現在足を除く）", minval=2, group=gf)
bool excludeRound = input.bool(true, "節目を勢いよく突破したら見送り", group=gf)
float roundPips = input.float(50.0, "節目の間隔（pips）", minval=0.1, step=1.0, group=gf)
float roundStep = math.max(syminfo.mintick, math.round(roundPips * pipSize / syminfo.mintick) * syminfo.mintick)
float momentum = input.float(1.5, "勢い：True Range / 直前ATR14", minval=0.1, step=0.1, group=gf)
int impulseBars = input.int(3, "突破後の勢いを見送る本数（0＝突破足だけ）", minval=0, maxval=20, group=gf)
bool excludeWick = input.bool(true, "長いヒゲでのバンドタッチを見送り", group=gf)
float wickBodyRatio = input.float(2.0, "ヒゲ長 / 実体の最小倍率（仮定）", minval=0.1, step=0.1, group=gf)
float wickRangePct = input.float(50.0, "ヒゲが足全体に占める最小％（仮定）", minval=1, maxval=100, step=1, group=gf)
bool manualPause = input.bool(false, "裁量見送り：候補を全停止（履歴全体にも適用）", group=gf)

string gr = "検証用の追加仮定"
bool useStop = input.bool(false, "固定損切りを使う（既定OFF・原条件に指定なし）", group=gr)
float slPips = input.float(10.0, "損切り幅 pips", minval=0.1, step=0.1, group=gr)
int stopTicks = useStop ? int(math.max(1, math.round(slPips * pipSize / syminfo.mintick))) : na

string gc = "仮想売買コスト（例示値・ペア別に設定）"
float spreadPips = input.float(1.2, "往復スプレッド相当 pips", minval=0, step=0.1, group=gc)
float slipPips = input.float(0.1, "片道スリッページ相当 pips（全決済にも適用）", minval=0, step=0.1, group=gc)
float feePips = input.float(0.0, "往復手数料相当 pips", minval=0, step=0.1, group=gc)
float costPips = spreadPips + 2 * slipPips + feePips

// Raw chart-price fills. Costs are subtracted once at settlement.
// Gaps are resolved first. If both levels are touched intrabar, assume SL first.
exitFill(int side, float barOpen, float barHigh, float barLow, float target, float stop) =>
    bool gapStop = not na(stop) and (side == 1 ? barOpen <= stop : barOpen >= stop)
    bool gapTarget = side == 1 ? barOpen >= target : barOpen <= target
    bool hitStop = not na(stop) and (side == 1 ? barLow <= stop : barHigh >= stop)
    bool hitTarget = side == 1 ? barHigh >= target : barLow <= target
    float price = gapStop or gapTarget ? barOpen : hitStop ? stop : hitTarget ? target : na
    bool stopped = gapStop or (not gapTarget and hitStop)
    [price, stopped]

tradePips(int side, float entry, float exit, float unit, float cost) =>
    side * (exit - entry) / unit - cost

bool gap = not na(time[1]) and time - time[1] > timeframe.in_seconds() * 1000
// Four separate calls preserve independent breakout memories; do not short-circuit.
recentImpulse(bool triggered, float brokenLevel, bool upward) =>
    var int started = na
    var float level = na
    if barstate.isconfirmed
        bool reclaimed = not na(level) and (upward ? close <= level : close >= level)
        bool expired = not na(started) and bar_index - started > impulseBars
        if gap or reclaimed or expired
            started := na
            level := na
        if triggered
            started := bar_index
            level := brokenLevel
    not na(started) and bar_index - started <= impulseBars

float basis = ta.sma(close, length)
float deviation = ta.stdev(close, length, true)
float upper = basis + sigma * deviation
float lower = basis - sigma * deviation
float priorHigh = ta.highest(high[1], lookback)
float priorLow = ta.lowest(low[1], lookback)
float priorAtr = ta.atr(14)[1]
bool impulsive = ta.tr(true) >= priorAtr * momentum
bool breakUp = close > priorHigh and impulsive
bool breakDown = close < priorLow and impulsive
float nextRound = (math.floor(close[1] / roundStep) + 1) * roundStep
float priorRound = (math.ceil(close[1] / roundStep) - 1) * roundStep
bool roundUp = high >= nextRound and close > nextRound and impulsive
bool roundDown = low <= priorRound and close < priorRound and impulsive
bool recentHighBreak = recentImpulse(breakUp, priorHigh, true)
bool recentLowBreak = recentImpulse(breakDown, priorLow, false)
bool recentRoundUp = recentImpulse(roundUp, nextRound, true)
bool recentRoundDown = recentImpulse(roundDown, priorRound, false)
bool buyExplained = (excludeBreak and recentLowBreak) or (excludeRound and recentRoundDown)
bool sellExplained = (excludeBreak and recentHighBreak) or (excludeRound and recentRoundUp)
bool chartOK = unitOK and (not restrictChart or timeframe.in_seconds() == 300)
// Persistent virtual portfolio: one fixed-size position, no pyramiding.
var int tradeSide = 0
var int pendingSide = 0
var int pendingBar = na
var float pendingTarget = na
var float entryPrice = na
var float targetPrice = na
var float stopPrice = na
var int closedCount = 0
var int winCount = 0
var float grossProfit = 0.0
var float grossLoss = 0.0
bool exited = false
float barEntry = tradeSide != 0 ? entryPrice : na
float barTarget = tradeSide != 0 ? targetPrice : na
float barStop = tradeSide != 0 ? stopPrice : na

if barstate.isconfirmed
    if tradeSide == 0 and pendingSide != 0 and bar_index > pendingBar
        tradeSide := pendingSide
        entryPrice := open
        targetPrice := pendingTarget
        stopPrice := useStop ? entryPrice - tradeSide * stopTicks * syminfo.mintick : na
        pendingSide := 0
        pendingBar := na
        pendingTarget := na
        label.new(bar_index, entryPrice, (tradeSide == 1 ? "仮想BUY " : "仮想SELL ") + str.tostring(entryPrice, format.mintick) + "\n中央線 " + str.tostring(targetPrice, format.mintick) + (useStop ? "\nSL " + str.tostring(stopPrice, format.mintick) : "\nSLなし"), style=tradeSide == 1 ? label.style_label_up : label.style_label_down, color=color.new(color.blue, 15), textcolor=color.white, size=size.tiny)
    if tradeSide != 0
        // Capture levels in force during THIS bar, before updating to its closing SMA.
        barEntry := entryPrice
        barTarget := targetPrice
        barStop := stopPrice
        [fillPrice, stopped] = exitFill(tradeSide, open, high, low, targetPrice, stopPrice)
        if not na(fillPrice)
            float resultPips = tradePips(tradeSide, entryPrice, fillPrice, pipSize, costPips)
            closedCount += 1
            grossProfit += math.max(resultPips, 0)
            grossLoss += math.max(-resultPips, 0)
            winCount += resultPips > 0 ? 1 : 0
            label.new(bar_index, fillPrice, (stopped ? "SL " : "中央線決済 ") + str.tostring(fillPrice, format.mintick) + "\n" + str.tostring(resultPips, "#.##") + " pips", style=label.style_label_left, color=resultPips > 0 ? color.teal : color.red, textcolor=color.white, size=size.tiny)
            exited := true
            tradeSide := 0
            entryPrice := na
            targetPrice := na
            stopPrice := na
        else
            targetPrice := basis

bool available = tradeSide == 0 and pendingSide == 0 and not exited
bool ready = available and chartOK and not na(deviation) and deviation > 0 and not na(priorAtr) and not na(priorHigh)
bool touchBuy = low <= lower
bool touchSell = high >= upper
// Use a one-tick body floor for dojis; reject only the touched side's wick.
longWick(float wick) =>
    excludeWick and high > low and wick >= math.max(math.abs(close - open), syminfo.mintick) * wickBodyRatio and wick >= (high - low) * wickRangePct / 100
bool buyWick = touchBuy and longWick(math.min(open, close) - low)
bool sellWick = touchSell and longWick(high - math.max(open, close))

var int armed = 0 // +1 buy preparation, -1 sell preparation; never a position
var int armedBar = na
int prepSide = 0
int signalSide = 0
string reason = ""

if barstate.isconfirmed
    // Discard a preparation across missing bars, including weekend gaps.
    if not ready or gap
        armed := 0
        armedBar := na
    if ready and armed != 0
        bool expired = bar_index - armedBar > expiry
        bool explained = armed == 1 ? buyExplained : sellExplained
        bool centerPassed = armed == 1 ? close >= basis : close <= basis
        bool oppositeTouch = armed == 1 ? touchSell : touchBuy
        bool wickBlocked = armed == 1 ? buyWick : sellWick
        reason := manualPause ? "裁量停止" : explained ? "突破の勢い" : wickBlocked ? "長いヒゲ" : expired ? "準備期限切れ" : centerPassed ? "中央線到達済み" : oppositeTouch ? "反対側タッチ" : ""
        if reason == "" and bar_index > armedBar and (not requireReturn or (close > lower and close < upper))
            reason := armed * (basis - close) / pipSize + 1e-9 < minCenterPips ? "中央線までの幅不足" : ""
            signalSide := reason == "" ? armed : 0
        if reason != "" or signalSide != 0
            armed := 0
            armedBar := na
    if ready and armed == 0 and reason == "" and signalSide == 0 and (touchBuy or touchSell)
        bool both = touchBuy and touchSell
        bool explained = touchBuy ? buyExplained : sellExplained
        bool wickBlocked = touchBuy ? buyWick : sellWick
        if both or manualPause or explained or wickBlocked
            reason := both ? "両側タッチ" : manualPause ? "裁量停止" : explained ? "突破の勢い" : "長いヒゲ"
        else
            armed := touchBuy ? 1 : -1
            armedBar := bar_index
            prepSide := armed

// Queue only after this bar's virtual fills have been processed.
if barstate.isconfirmed and signalSide != 0
    pendingSide := signalSide
    pendingBar := bar_index
    pendingTarget := basis

plot(barEntry, "仮想Entry価格（コスト控除前）", color=color.aqua, linewidth=2, style=plot.style_linebr)
plot(barTarget, "当該足の中央線決済価格", color=color.lime, linewidth=2, style=plot.style_linebr)
plot(barStop, "SL価格", color=color.red, linewidth=2, style=plot.style_linebr)

plot(basis, "BB中央線：次足以降の決済指値", color=color.orange, linewidth=2)
u = plot(upper, "+3σ", color=color.new(color.blue, 15))
l = plot(lower, "−3σ", color=color.new(color.blue, 15))
fill(u, l, color=color.new(color.blue, 95))
plotshape(prepSide == 1, "買い準備", shape.circle, location.belowbar, color=color.yellow, text="準備", textcolor=color.yellow, size=size.tiny)
plotshape(prepSide == -1, "売り準備", shape.circle, location.abovebar, color=color.yellow, text="準備", textcolor=color.yellow, size=size.tiny)
plotshape(signalSide == 1, "買い候補：検証用エントリー信号", shape.labelup, location.belowbar, color=color.teal, text="BUY信号", textcolor=color.white, size=size.tiny)
plotshape(signalSide == -1, "売り候補：検証用エントリー信号", shape.labeldown, location.abovebar, color=color.red, text="SELL信号", textcolor=color.white, size=size.tiny)
if reason != "" and barstate.isconfirmed
    label.new(bar_index, high, "見送り\n" + reason, style=label.style_label_down, color=color.new(color.gray, 30), textcolor=color.white, size=size.tiny)

// PF excludes open P/L; show its cost-adjusted mark-to-close separately.
float openPips = tradeSide != 0 ? tradePips(tradeSide, entryPrice, close, pipSize, costPips) : 0.0
float pf = grossLoss > 0 ? grossProfit / grossLoss : na
string pfText = closedCount == 0 ? "—（決済なし）" : grossLoss > 0 ? str.tostring(pf, "#.###") : grossProfit > 0 ? "算出不能（損失なし）" : "—（損益ゼロ）"
float winRate = closedCount > 0 ? 100.0 * winCount / closedCount : na

tableRow(table panel, int row, string title, string value, color titleColor = color.white, color valueColor = color.white) =>
    table.cell(panel, 0, row, title, text_color=titleColor, bgcolor=color.black)
    table.cell(panel, 1, row, value, text_color=valueColor, bgcolor=color.black)

bool showMainPanel = input.bool(false, "メイン銘柄のPF集計を表示", group="表示")
var table notice = table.new(position.top_right, 2, 9)
if barstate.islast and showMainPanel
    tableRow(notice, 0, "仮想集計・裁量未再現", not unitOK ? "FX以外：pip幅を手動設定" : chartOK ? syminfo.ticker + " / " + timeframe.period : "5分足へ変更", color.yellow, color.yellow)
    tableRow(notice, 1, "PF（仮想・コスト控除後）", pfText)
    tableRow(notice, 2, "決済数 / 勝率", str.tostring(closedCount) + " / " + (na(winRate) ? "—" : str.tostring(winRate, "#.##") + "%"))
    tableRow(notice, 3, "確定損益 pips", str.tostring(grossProfit - grossLoss, "#.##"))
    tableRow(notice, 4, "含み損益 pips（PF対象外）", str.tostring(openPips, "#.##"))
    tableRow(notice, 5, "損切り", useStop ? str.tostring(stopTicks * syminfo.mintick / pipSize, "#.##") + " pips" : "なし・含み損に注意", color.white, color.yellow)
    tableRow(notice, 6, "コスト設定", str.tostring(costPips, "#.##") + " pips / 往復", color.yellow, color.yellow)
    tableRow(notice, 7, "検証範囲", "読込済み履歴のみ検証", color.yellow, color.yellow)
    tableRow(notice, 8, "pip幅 / 節目幅（価格）", str.tostring(pipSize, "#.########") + " / " + str.tostring(roundStep, format.mintick))

alertcondition(signalSide == 1 and barstate.isconfirmed, "買い候補確定", "{{ticker}} BB買い候補。仮想売買では次足始値でエントリー。相場背景を手動確認。")
alertcondition(signalSide == -1 and barstate.isconfirmed, "売り候補確定", "{{ticker}} BB売り候補。仮想売買では次足始値でエントリー。相場背景を手動確認。")
alertcondition(exited and barstate.isconfirmed, "仮想決済確定", "{{ticker}} BB仮想決済を足確定時に集計。実注文の約定通知ではありません。")

// Latest trade price guides (display only; historical price plots remain above).
bool showPriceGuides = input.bool(true, "Entry・利確・損切りの価格ラインを表示", group="表示")
priceGuide(float price, string title, color ink) =>
    var line guide = na
    var label tag = na
    if barstate.islast
        if showPriceGuides and not na(price)
            if na(guide)
                guide := line.new(bar_index, price, bar_index + 5, price, color=ink, width=2)
            if na(tag)
                tag := label.new(bar_index + 5, price, "", style=label.style_label_left, color=ink, textcolor=color.black, size=size.small)
            line.set_xy1(guide, bar_index, price)
            line.set_xy2(guide, bar_index + 5, price)
            line.set_color(guide, ink)
            label.set_xy(tag, bar_index + 5, price)
            label.set_color(tag, ink)
            label.set_text(tag, title + " " + str.tostring(price, format.mintick))
        else
            line.delete(guide)
            label.delete(tag)
            guide := na
            tag := na
    0

// Show this position/order only; never attach a settled trade to a new signal.
bool guidePending = tradeSide == 0 and pendingSide != 0
int guideSide = tradeSide != 0 ? tradeSide : pendingSide
float guideEntry = tradeSide != 0 ? entryPrice : guidePending ? (bar_index > pendingBar ? open : close) : na
float guideTarget = tradeSide != 0 ? targetPrice : guidePending ? pendingTarget : na
float guideStop = tradeSide != 0 ? stopPrice : guidePending and useStop ? guideEntry - guideSide * stopTicks * syminfo.mintick : na
string guidePhase = tradeSide != 0 ? "（仮想保有中）" : guidePending ? (bar_index > pendingBar ? "（仮表示・次足始値）" : "（予定・信号終値基準）") : ""
string guideDirection = guideSide == 1 ? "BUY " : "SELL "
bool lossTarget = not na(guideEntry) and guideSide * (guideTarget - guideEntry) <= 0
priceGuide(guideEntry, guideDirection + "Entry" + guidePhase, color.aqua)
priceGuide(guideTarget, guideDirection + (lossTarget ? "中央線決済・利益側ではない" : "利確・中央線") + guidePhase, lossTarget ? color.orange : color.lime)
priceGuide(guideStop, guideDirection + "損切り" + guidePhase, color.red)

// Multi-symbol opportunity scanner
// Reference-only: the existing chart signals, fills and PF above are unchanged.
string gs = "チャンス通貨一覧（参考・未検証）"
bool showScanner = input.bool(true, "通貨一覧を表示", group=gs)
string scannerPosition = input.string("左下", "一覧の位置", options=["左上", "左下"], group=gs)
bool scannerAlerts = input.bool(false, "一覧の確定BUY/SELL信号を通知（参考）", group=gs)
string scan01 = input.symbol("OANDA:USDJPY", "01", group=gs)
string scan02 = input.symbol("OANDA:EURUSD", "02", group=gs)
string scan03 = input.symbol("OANDA:GBPUSD", "03", group=gs)
string scan04 = input.symbol("OANDA:AUDUSD", "04", group=gs)
string scan05 = input.symbol("OANDA:NZDUSD", "05", group=gs)
string scan06 = input.symbol("OANDA:USDCAD", "06", group=gs)
string scan07 = input.symbol("OANDA:USDCHF", "07", group=gs)
string scan08 = input.symbol("OANDA:EURJPY", "08", group=gs)
string scan09 = input.symbol("OANDA:GBPJPY", "09", group=gs)
string scan10 = input.symbol("OANDA:AUDJPY", "10", group=gs)
string scan11 = input.symbol("OANDA:NZDJPY", "11", group=gs)

// Separate call-site memories in each requested symbol. Never use isconfirmed in security.
scannerImpulse(bool triggered, float brokenLevel, bool upward, bool sourceGap) =>
    var int started = na
    var float level = na
    if sourceGap or (not na(level) and (upward ? close <= level : close >= level)) or (not na(started) and bar_index - started > impulseBars)
        started := na
        level := na
    if triggered
        started := bar_index
        level := brokenLevel
    not na(started) and bar_index - started <= impulseBars

// Per-symbol preparation, occupancy and closed-trade statistics; no chart drawings or alerts.
// All returned fields are offset together; current source-bar calculations never escape.
scannerSnapshot() =>
    float unit = autoPip ? (syminfo.currency == "JPY" ? 0.01 : 0.0001) : manualPip
    bool valid = (not autoPip or syminfo.type == "forex") and (not restrictChart or timeframe.in_seconds() == 300)
    float step = math.max(syminfo.mintick, math.round(roundPips * unit / syminfo.mintick) * syminfo.mintick)
    float center = ta.sma(close, length)
    float dev = ta.stdev(close, length, true)
    float top = center + sigma * dev
    float bottom = center - sigma * dev
    float hi = ta.highest(high[1], lookback)
    float lo = ta.lowest(low[1], lookback)
    float atr = ta.atr(14)[1]
    bool strong = ta.tr(true) >= atr * momentum
    bool sourceGap = not na(time[1]) and time - time[1] > timeframe.in_seconds() * 1000
    float upLevel = (math.floor(close[1] / step) + 1) * step
    float downLevel = (math.ceil(close[1] / step) - 1) * step
    bool highBreak = scannerImpulse(close > hi and strong, hi, true, sourceGap)
    bool lowBreak = scannerImpulse(close < lo and strong, lo, false, sourceGap)
    bool upBreak = scannerImpulse(high >= upLevel and close > upLevel and strong, upLevel, true, sourceGap)
    bool downBreak = scannerImpulse(low <= downLevel and close < downLevel and strong, downLevel, false, sourceGap)
    bool buyBlocked = (excludeBreak and lowBreak) or (excludeRound and downBreak)
    bool sellBlocked = (excludeBreak and highBreak) or (excludeRound and upBreak)
    bool buyTouch = low <= bottom
    bool sellTouch = high >= top
    bool badBuyWick = buyTouch and longWick(math.min(open, close) - low)
    bool badSellWick = sellTouch and longWick(high - math.max(open, close))
    var int positionSide = 0
    var float filledEntry = na
    var int closedTrades = 0
    var int winningTrades = 0
    var int queuedSide = 0
    var int queuedBar = na
    var float target = na
    var float stop = na
    var int preparation = 0
    var int preparationBar = na
    bool closed = false
    if positionSide == 0 and queuedSide != 0 and bar_index > queuedBar
        positionSide := queuedSide
        filledEntry := open
        int ticks = int(math.max(1, math.round(slPips * unit / syminfo.mintick)))
        stop := useStop ? open - positionSide * ticks * syminfo.mintick : na
        queuedSide := 0
        queuedBar := na
    if positionSide != 0
        [price, stopped] = exitFill(positionSide, open, high, low, target, stop)
        if not na(price)
            closedTrades += 1
            winningTrades += tradePips(positionSide, filledEntry, price, unit, costPips) > 0 ? 1 : 0
            filledEntry := na
            closed := true
            positionSide := 0
            target := na
            stop := na
        else
            target := center
    bool canPrepare = positionSide == 0 and queuedSide == 0 and not closed and valid and not na(dev) and dev > 0 and not na(atr) and not na(hi)
    int signal = 0
    string skip = ""
    if not canPrepare or sourceGap
        preparation := 0
        preparationBar := na
    if canPrepare and preparation != 0
        bool explained = preparation == 1 ? buyBlocked : sellBlocked
        bool wick = preparation == 1 ? badBuyWick : badSellWick
        bool passed = preparation == 1 ? close >= center : close <= center
        bool opposite = preparation == 1 ? sellTouch : buyTouch
        skip := manualPause ? "裁量停止" : explained ? "突破の勢い" : wick ? "長いヒゲ" : bar_index - preparationBar > expiry ? "準備期限切れ" : passed ? "中央線到達済み" : opposite ? "反対側タッチ" : ""
        if skip == "" and bar_index > preparationBar and (not requireReturn or (close > bottom and close < top))
            skip := preparation * (center - close) / unit + 1e-9 < minCenterPips ? "中央線までの幅不足" : ""
            signal := skip == "" ? preparation : 0
        if skip != "" or signal != 0
            preparation := 0
            preparationBar := na
    if canPrepare and preparation == 0 and skip == "" and signal == 0 and (buyTouch or sellTouch)
        bool both = buyTouch and sellTouch
        bool explained = buyTouch ? buyBlocked : sellBlocked
        bool wick = buyTouch ? badBuyWick : badSellWick
        if both or manualPause or explained or wick
            skip := both ? "両側タッチ" : manualPause ? "裁量停止" : explained ? "突破の勢い" : "長いヒゲ"
        else
            preparation := buyTouch ? 1 : -1
            preparationBar := bar_index
    if signal != 0
        queuedSide := signal
        queuedBar := bar_index
        target := center
    bool dataReady = valid and not na(dev) and not na(atr) and not na(hi)
    int state = not dataReady ? 5 : signal != 0 ? signal * 3 : positionSide != 0 ? positionSide : preparation != 0 ? preparation * 2 : skip != "" or manualPause ? 4 : 0
    float distance = math.abs(center - close) / unit
    [state[1], distance[1], time_close[1], skip[1], winningTrades[1], closedTrades[1]]

scannerName(int state) =>
    state == 3 ? "BUY信号" : state == -3 ? "SELL信号" : state == 2 ? "買い準備" : state == -2 ? "売り準備" : state == 1 ? "仮想BUY保有" : state == -1 ? "仮想SELL保有" : state == 4 ? "見送り" : state == 5 ? "対象外/計算待ち" : state == 6 ? "データなし" : state == 7 ? "更新待ち（古い）" : "待機"

scannerRank(int state) =>
    math.abs(state) == 3 ? 0 : math.abs(state) == 2 ? 1 : math.abs(state) == 1 ? 2 : state == 4 ? 3 : state == 0 ? 4 : 5

var table scanner = table.new(scannerPosition == "左上" ? position.top_left : position.bottom_left, 6, 13)
varip array<int> scannerNotified = array.new_int(11, 0)
array<string> scannerSymbols = array.from(scan01, scan02, scan03, scan04, scan05, scan06, scan07, scan08, scan09, scan10, scan11)
array<int> scannerStates = array.new_int(11, 6)
array<float> scannerDistances = array.new_float(11, na)
array<int> scannerTimes = array.new_int(11, na)
array<int> scannerWins = array.new_int(11, na)
array<int> scannerClosed = array.new_int(11, na)
array<string> scannerReasons = array.new_string(11, "")
array<int> scannerOrder = array.new_int()
string scannerMessage = ""
if showScanner or scannerAlerts
    for i = 0 to 10
        string symbol = array.get(scannerSymbols, i)
        // Empty inputs use the chart symbol; normalize before checking duplicates.
        symbol := symbol == "" ? syminfo.tickerid : symbol
        array.set(scannerSymbols, i, symbol)
        bool duplicate = array.indexof(scannerSymbols, symbol) < i
        if not duplicate
            [state, distance, stamp, skip, wins, trades] = request.security(symbol, timeframe.period, scannerSnapshot(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
            bool stale = not na(stamp) and (timenow - stamp > timeframe.in_seconds() * 2000 or stamp > timenow)
            state := na(state) or na(stamp) ? 6 : stale ? 7 : state
            array.set(scannerStates, i, state)
            array.set(scannerDistances, i, distance)
            array.set(scannerTimes, i, stamp)
            array.set(scannerWins, i, wins)
            array.set(scannerClosed, i, trades)
            array.set(scannerReasons, i, skip)
            array.push(scannerOrder, i)
            bool seed = barstate.isrealtime and not na(stamp) and array.get(scannerNotified, i) == 0
            if seed
                array.set(scannerNotified, i, stamp)
            if scannerAlerts and barstate.isrealtime and not seed and math.abs(state) == 3 and stamp != array.get(scannerNotified, i)
                scannerMessage += symbol + " " + scannerName(state) + " / 中央線まで " + str.tostring(distance, "#.##") + " pips / " + str.format_time(stamp, "MM-dd HH:mm", "Asia/Tokyo") + " JST\n"
                array.set(scannerNotified, i, stamp)
if scannerMessage != ""
    alert("BB参考信号・実注文なし\n" + scannerMessage, alert.freq_all)
if barstate.islast
    table.clear(scanner, 0, 0, 5, 12)
    if showScanner
        // Stable insertion sort keeps input order within each opportunity class.
        int count = array.size(scannerOrder)
        if count > 1
            for i = 1 to count - 1
                int item = array.get(scannerOrder, i)
                int j = i - 1
                while j >= 0
                    if scannerRank(array.get(scannerStates, array.get(scannerOrder, j))) <= scannerRank(array.get(scannerStates, item))
                        break
                    array.set(scannerOrder, j + 1, array.get(scannerOrder, j))
                    j -= 1
                array.set(scannerOrder, j + 1, item)
        table.cell(scanner, 0, 0, "参考・未検証", text_color=color.yellow, bgcolor=color.black, text_size=size.small)
        table.cell(scanner, 1, 0, restrictChart and timeframe.in_seconds() != 300 ? "5分足へ変更" : "確定足 / " + timeframe.period, text_color=color.yellow, bgcolor=color.black, text_size=size.small)
        table.cell(scanner, 2, 0, "信号≠約定", text_color=color.yellow, bgcolor=color.black, text_size=size.small)
        table.cell(scanner, 3, 0, "次足更新時 / 停止中は更新なし", text_color=color.yellow, bgcolor=color.black, text_size=size.small, tooltip="現在時刻を基準に2本超の古いデータを除外。休場中は次のチャート更新まで表示も停止します。リプレイの過去足はチャンス通知対象外です。")
        table.cell(scanner, 4, 0, "仮想・コスト控除後", text_color=color.yellow, bgcolor=color.black, text_size=size.small)
        table.cell(scanner, 5, 0, "読込済み履歴", text_color=color.yellow, bgcolor=color.black, text_size=size.small)
        array<string> headers = array.from("通貨（配信元）", "状態", "中央線幅 pips", "確認足終値 JST", "勝率", "決済数")
        for col = 0 to 5
            table.cell(scanner, col, 1, array.get(headers, col), text_color=color.white, bgcolor=color.gray, text_size=size.small)
        for row = 0 to count - 1
            int i = array.get(scannerOrder, row)
            int state = array.get(scannerStates, i)
            int stamp = array.get(scannerTimes, i)
            int trades = array.get(scannerClosed, i)
            int wins = array.get(scannerWins, i)
            bool statsReady = not na(stamp) and state != 5 and state != 6 and not na(trades)
            string rate = statsReady and trades > 0 ? str.tostring(100.0 * wins / trades, "#.##") + "%" : "—"
            color ink = math.abs(state) == 3 ? color.white : math.abs(state) == 2 ? color.yellow : color.silver
            color bg = state == 3 ? color.new(color.teal, 15) : state == -3 ? color.new(color.red, 15) : color.new(color.black, 15)
            table.cell(scanner, 0, row + 2, array.get(scannerSymbols, i), text_color=ink, bgcolor=bg, text_size=size.small)
            table.cell(scanner, 1, row + 2, scannerName(state), text_color=ink, bgcolor=bg, text_size=size.small, tooltip=state == 4 ? array.get(scannerReasons, i) : "直前確定足の状態。準備はエントリーではありません。保有は仮想記録です。")
            table.cell(scanner, 2, row + 2, state >= 5 ? "—" : str.tostring(array.get(scannerDistances, i), "#.##"), text_color=ink, bgcolor=bg, text_size=size.small, tooltip="確定終値と中央線の絶対距離・コスト控除前。約定時の利幅ではありません。")
            table.cell(scanner, 3, row + 2, na(stamp) ? "—" : str.format_time(stamp, "MM-dd HH:mm", "Asia/Tokyo"), text_color=ink, bgcolor=bg, text_size=size.small)
            table.cell(scanner, 4, row + 2, rate, text_color=ink, bgcolor=bg, text_size=size.small, tooltip="確認足時点の仮想集計。往復コスト控除後の損益が正の決済数 ÷ 全決済数。未決済は除外。将来の成功確率ではありません。")
            table.cell(scanner, 5, row + 2, statsReady ? str.tostring(trades) : "—", text_color=ink, bgcolor=bg, text_size=size.small, tooltip="各通貨の読込済み履歴のみ。期間は配信元・履歴量に依存し、全通貨に同じコスト設定を使用します。更新待ちの行は表示時刻までの過去集計です。")
