//@version=6
// 4Hの確定ダウ方向へ、15分足のトレンドライン／押し戻りブレイクで入る。
// 決済後に曜日、時間帯、保有分数、方向一致、pips、勝敗などを記録する研究用インジケーター。
indicator("よすが式 4H順張り・15分足エントリー RR1 + 取引評価 v1", overlay=true,
     max_labels_count=400, max_lines_count=120, dynamic_requests=true)
plot(close, "Compile guard", display=display.none)

string gTrend = "4H・15分足ロジック"
string i_higherTf = input.timeframe("240", "上位足", group=gTrend)
int i_htfPivot = input.int(2, "4Hピボット左右", minval=1, maxval=10, group=gTrend)
int i_ltfPivot = input.int(2, "15分足ピボット左右", minval=1, maxval=10, group=gTrend)
int i_fastEma = input.int(20, "15分足 高速EMA", minval=2, group=gTrend)
int i_slowEma = input.int(50, "15分足 低速EMA", minval=5, group=gTrend)
int i_breakLookback = input.int(4, "直近高安ブレイク本数", minval=2, maxval=20, group=gTrend)
int i_pullbackLookback = input.int(8, "押し戻り探索本数", minval=3, maxval=40, group=gTrend)
float i_pullbackAtr = input.float(0.30, "EMA接近幅（ATR倍）", minval=0.05, step=0.05, group=gTrend)
bool i_requireFiveMinute = input.bool(false, "5分足方向の一致も必須", group=gTrend)

string gControl = "曜日・時間・連続取引"
string i_session = input.session("0600-2000", "エントリー時間帯", group=gControl)
bool i_monday = input.bool(true, "月曜日", inline="days1", group=gControl)
bool i_tuesday = input.bool(true, "火曜日", inline="days1", group=gControl)
bool i_wednesday = input.bool(true, "水曜日", inline="days1", group=gControl)
bool i_thursday = input.bool(true, "木曜日", inline="days2", group=gControl)
bool i_friday = input.bool(true, "金曜日", inline="days2", group=gControl)
int i_maxTradesPerDay = input.int(3, "1日の最大取引回数", minval=1, maxval=10, group=gControl)
int i_cooldownBars = input.int(4, "通常クールダウン（15分足本数）", minval=0, maxval=40, group=gControl)
bool i_pauseAfterLoss = input.bool(true, "1回前が負けなら長めに休止", group=gControl)
int i_lossCooldownBars = input.int(8, "負け後の休止（15分足本数）", minval=1, maxval=80, group=gControl)

string gRisk = "決済・評価"
float i_spread = input.float(0.0, "スプレッド価格差", minval=0.0, step=0.00001, group=gRisk)
float i_stopBufferAtr = input.float(0.20, "SLバッファ（ATR倍）", minval=0.0, step=0.05, group=gRisk)
float i_maxRiskAtr = input.float(2.50, "最大SL幅（ATR倍）", minval=0.5, step=0.25, group=gRisk)
string i_tradeMode = input.string("Auto", "取引種別", options=["Auto", "Scalp", "Daytrade"], group=gRisk)
int i_scalpMaxMinutes = input.int(60, "スキャ判定の最大保有分", minval=15, maxval=240, group=gRisk)
int i_maxHoldMinutes = input.int(480, "最大保有分（超過は撤退）", minval=30, maxval=1440, group=gRisk)
int i_lineBars = input.int(24, "Entry・SL・TPラインの長さ", minval=3, maxval=200, group=gRisk)
bool i_showStats = input.bool(true, "成績を表示", group=gRisk)
bool i_showJournal = input.bool(true, "直近トレード評価を表示", group=gRisk)

string gScanner = "通貨ペア・狙い目一覧"
bool i_showScanner = input.bool(true, "12通貨を一覧表示", group=gScanner)
string i_scanSymbol1 = input.symbol("OANDA:EURUSD", "1", group=gScanner)
string i_scanSymbol2 = input.symbol("OANDA:GBPUSD", "2", group=gScanner)
string i_scanSymbol3 = input.symbol("OANDA:USDJPY", "3", group=gScanner)
string i_scanSymbol4 = input.symbol("OANDA:AUDUSD", "4", group=gScanner)
string i_scanSymbol5 = input.symbol("OANDA:NZDUSD", "5", group=gScanner)
string i_scanSymbol6 = input.symbol("OANDA:USDCAD", "6", group=gScanner)
string i_scanSymbol7 = input.symbol("OANDA:USDCHF", "7", group=gScanner)
string i_scanSymbol8 = input.symbol("OANDA:EURJPY", "8", group=gScanner)
string i_scanSymbol9 = input.symbol("OANDA:GBPJPY", "9", group=gScanner)
string i_scanSymbol10 = input.symbol("OANDA:AUDJPY", "10", group=gScanner)
string i_scanSymbol11 = input.symbol("OANDA:CHFJPY", "11", group=gScanner)
string i_scanSymbol12 = input.symbol("OANDA:EURGBP", "12", group=gScanner)

f_contextPack(int pivotLength) =>
    float pivotHigh = ta.pivothigh(high, pivotLength, pivotLength)
    float pivotLow = ta.pivotlow(low, pivotLength, pivotLength)
    float lastHigh = ta.valuewhen(not na(pivotHigh), pivotHigh, 0)
    float previousHigh = ta.valuewhen(not na(pivotHigh), pivotHigh, 1)
    float lastLow = ta.valuewhen(not na(pivotLow), pivotLow, 0)
    float previousLow = ta.valuewhen(not na(pivotLow), pivotLow, 1)
    [lastHigh[1], previousHigh[1], lastLow[1], previousLow[1]]

f_fiveMinuteTrend() =>
    float fast = ta.ema(close, 20)
    float slow = ta.ema(close, 50)
    int trend = fast > slow and close > fast ? 1 : fast < slow and close < fast ? -1 : 0
    trend[1]

f_allowedDay() =>
    (dayofweek == dayofweek.monday and i_monday) or
     (dayofweek == dayofweek.tuesday and i_tuesday) or
     (dayofweek == dayofweek.wednesday and i_wednesday) or
     (dayofweek == dayofweek.thursday and i_thursday) or
     (dayofweek == dayofweek.friday and i_friday)

f_weekdayText(int value) =>
    value == dayofweek.monday ? "月" : value == dayofweek.tuesday ? "火" : value == dayofweek.wednesday ? "水" : value == dayofweek.thursday ? "木" : value == dayofweek.friday ? "金" : value == dayofweek.saturday ? "土" : "日"

f_timeBand(int value) =>
    value < 9 ? "早朝" : value < 15 ? "東京" : value < 21 ? "欧州" : "NY"

f_pairName(string symbol) =>
    string value = str.replace_all(symbol, "OANDA:", "")
    value := str.replace_all(value, "FX:", "")
    value := str.replace_all(value, "FOREXCOM:", "")
    value

color cJournalPanel = color.rgb(17, 24, 39)
color cJournalKey = color.rgb(31, 41, 55)
color cJournalBorder = color.rgb(100, 116, 139)
color cJournalText = color.rgb(248, 250, 252)
color cJournalMuted = color.rgb(203, 213, 225)

f_journalKey(table target, int row, string labelText) =>
    table.cell(target, 0, row, labelText, text_color=cJournalMuted, bgcolor=cJournalKey,
         text_size=size.small, text_halign=text.align_left)

f_journalValue(table target, int row, string valueText, color textColor) =>
    table.cell(target, 1, row, valueText, text_color=textColor, bgcolor=cJournalPanel,
         text_size=size.small, text_halign=text.align_left)

[htfLastHigh, htfPreviousHigh, htfLastLow, htfPreviousLow] = request.security(
     syminfo.tickerid, i_higherTf, f_contextPack(i_htfPivot),
     gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
int fiveMinuteTrend = request.security(
     syminfo.tickerid, "5", f_fiveMinuteTrend(),
     gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)

bool hasHtf = not na(htfLastHigh) and not na(htfPreviousHigh) and not na(htfLastLow) and not na(htfPreviousLow)
int htfTrend = hasHtf and htfLastHigh > htfPreviousHigh and htfLastLow > htfPreviousLow ? 1 : hasHtf and htfLastHigh < htfPreviousHigh and htfLastLow < htfPreviousLow ? -1 : 0

float pivotHigh = ta.pivothigh(high, i_ltfPivot, i_ltfPivot)
float pivotLow = ta.pivotlow(low, i_ltfPivot, i_ltfPivot)
float lastHigh = ta.valuewhen(not na(pivotHigh), pivotHigh, 0)
float previousHigh = ta.valuewhen(not na(pivotHigh), pivotHigh, 1)
float lastLow = ta.valuewhen(not na(pivotLow), pivotLow, 0)
float previousLow = ta.valuewhen(not na(pivotLow), pivotLow, 1)
int lastHighBar = ta.valuewhen(not na(pivotHigh), bar_index - i_ltfPivot, 0)
int previousHighBar = ta.valuewhen(not na(pivotHigh), bar_index - i_ltfPivot, 1)
int lastLowBar = ta.valuewhen(not na(pivotLow), bar_index - i_ltfPivot, 0)
int previousLowBar = ta.valuewhen(not na(pivotLow), bar_index - i_ltfPivot, 1)

float emaFast = ta.ema(close, i_fastEma)
float emaSlow = ta.ema(close, i_slowEma)
float atrValue = ta.atr(14)
bool ltfUp = emaFast > emaSlow and close > emaFast and lastHigh > previousHigh and lastLow > previousLow
bool ltfDown = emaFast < emaSlow and close < emaFast and lastHigh < previousHigh and lastLow < previousLow

float fallingLine = na
if not na(lastHighBar) and not na(previousHighBar) and lastHighBar != previousHighBar
    float highSlope = (lastHigh - previousHigh) / (lastHighBar - previousHighBar)
    fallingLine := lastHigh + highSlope * (bar_index - lastHighBar)
float risingLine = na
if not na(lastLowBar) and not na(previousLowBar) and lastLowBar != previousLowBar
    float lowSlope = (lastLow - previousLow) / (lastLowBar - previousLowBar)
    risingLine := lastLow + lowSlope * (bar_index - lastLowBar)

bool trendlineBuy = not na(fallingLine) and close > fallingLine and close[1] <= fallingLine[1]
bool trendlineSell = not na(risingLine) and close < risingLine and close[1] >= risingLine[1]
float previousBreakHigh = ta.highest(high[1], i_breakLookback)
float previousBreakLow = ta.lowest(low[1], i_breakLookback)
bool recentLongPullback = ta.lowest(low, i_pullbackLookback) <= emaFast + atrValue * i_pullbackAtr
bool recentShortPullback = ta.highest(high, i_pullbackLookback) >= emaFast - atrValue * i_pullbackAtr
bool pullbackBuy = recentLongPullback and close > previousBreakHigh and close[1] <= previousBreakHigh[1]
bool pullbackSell = recentShortPullback and close < previousBreakLow and close[1] >= previousBreakLow[1]

bool isFifteenMinute = timeframe.isminutes and timeframe.multiplier == 15
bool sessionOk = not na(time(timeframe.period, i_session))
bool dayOk = f_allowedDay()
bool fiveLongAligned = fiveMinuteTrend == 1
bool fiveShortAligned = fiveMinuteTrend == -1
bool fiveLongOk = not i_requireFiveMinute or fiveLongAligned
bool fiveShortOk = not i_requireFiveMinute or fiveShortAligned

var int positionDirection = 0
var int entryBar = na
var int entryTime = na
var float activeEntry = na
var float activeStop = na
var float activeTarget = na
var int wins = 0
var int losses = 0
var int withdrawals = 0
var int dailyTrades = 0
var int storedDay = na
var int lastExitBar = -10000
var int lastLossBar = -10000
var string previousResult = "なし"
var int entriesInHtfLeg = 0
var int storedHtfTrend = 0

var string entryWeekday = "-"
var string entryBand = "-"
var string entrySide = "-"
var string entry15Aligned = "-"
var string entry5Aligned = "-"
var string entryReason = "-"
var string entryPhase = "-"
var string entryTradeNumber = "-"
var string entryPreviousResult = "-"
var string lastWeekday = "-"
var string lastBand = "-"
var string lastSide = "-"
var string last15Aligned = "-"
var string last5Aligned = "-"
var string lastReason = "-"
var string lastPhase = "-"
var string lastTradeNumber = "-"
var string lastPreviousResult = "-"
var string lastHoldMinutes = "-"
var string lastEvaluation = "-"
var string lastPips = "-"
var string lastResult = "-"
var string lastStyle = "-"

int currentDay = year * 10000 + month * 100 + dayofmonth
if na(storedDay) or currentDay != storedDay
    storedDay := currentDay
    dailyTrades := 0
if htfTrend != storedHtfTrend
    storedHtfTrend := htfTrend
    entriesInHtfLeg := 0

bool normalCooldownOk = bar_index - lastExitBar > i_cooldownBars
bool lossCooldownOk = not i_pauseAfterLoss or previousResult != "負け" or bar_index - lastLossBar > i_lossCooldownBars
bool frequencyOk = dailyTrades < i_maxTradesPerDay and normalCooldownOk and lossCooldownOk
float proposedLongEntry = close + i_spread
float proposedLongStop = lastLow - atrValue * i_stopBufferAtr
float proposedLongRisk = proposedLongEntry - proposedLongStop
float proposedShortEntry = close
float proposedShortStop = lastHigh + atrValue * i_stopBufferAtr + i_spread
float proposedShortRisk = proposedShortStop - proposedShortEntry
bool longRiskOk = proposedLongRisk > syminfo.mintick and proposedLongRisk <= atrValue * i_maxRiskAtr
bool shortRiskOk = proposedShortRisk > syminfo.mintick and proposedShortRisk <= atrValue * i_maxRiskAtr
bool longTrigger = trendlineBuy or pullbackBuy
bool shortTrigger = trendlineSell or pullbackSell
bool buySetup = barstate.isconfirmed and isFifteenMinute and htfTrend == 1 and ltfUp and fiveLongOk and dayOk and sessionOk and frequencyOk and longTrigger and longRiskOk
bool sellSetup = barstate.isconfirmed and isFifteenMinute and htfTrend == -1 and ltfDown and fiveShortOk and dayOk and sessionOk and frequencyOk and shortTrigger and shortRiskOk

bool exitedThisBar = false
if barstate.isconfirmed and positionDirection != 0 and bar_index > entryBar
    bool stopHit = positionDirection == 1 ? low <= activeStop : high + i_spread >= activeStop
    bool targetHit = positionDirection == 1 ? high >= activeTarget : low + i_spread <= activeTarget
    int heldMinutes = int((time - entryTime) / 60000)
    bool trendExit = htfTrend != positionDirection
    bool timeExit = heldMinutes >= i_maxHoldMinutes
    if stopHit or targetHit or trendExit or timeExit
        float exitPrice = stopHit ? activeStop : targetHit ? activeTarget : close
        float pipSize = syminfo.mintick * 10.0
        float earnedPips = (exitPrice - activeEntry) * positionDirection / pipSize
        string result = stopHit ? "負け" : targetHit ? "勝ち" : "撤退"
        string evaluation = result == "勝ち" and entry15Aligned == "同方向" and entry5Aligned == "同方向" ? "A" : result == "勝ち" or result == "撤退" and earnedPips >= 0 ? "B" : "C"
        string style = i_tradeMode == "Scalp" ? "スキャ" : i_tradeMode == "Daytrade" ? "デイトレ" : heldMinutes <= i_scalpMaxMinutes ? "スキャ" : "デイトレ"
        if result == "勝ち"
            wins += 1
        else if result == "負け"
            losses += 1
            lastLossBar := bar_index
        else
            withdrawals += 1
        previousResult := result
        lastExitBar := bar_index
        lastHoldMinutes := str.tostring(heldMinutes)
        lastEvaluation := evaluation
        lastPips := str.tostring(earnedPips, "#.1")
        lastResult := result
        lastStyle := style
        lastWeekday := entryWeekday
        lastBand := entryBand
        lastSide := entrySide
        last15Aligned := entry15Aligned
        last5Aligned := entry5Aligned
        lastReason := entryReason
        lastPhase := entryPhase
        lastTradeNumber := entryTradeNumber
        lastPreviousResult := entryPreviousResult
        label.new(bar_index, exitPrice, result + " " + lastPips + "pips", style=result == "勝ち" ? label.style_label_up : label.style_label_down, color=result == "勝ち" ? color.green : result == "負け" ? color.red : color.orange, textcolor=color.white, size=size.tiny)
        positionDirection := 0
        activeEntry := na
        activeStop := na
        activeTarget := na
        exitedThisBar := true

bool newBuy = not exitedThisBar and positionDirection == 0 and buySetup
bool newSell = not exitedThisBar and positionDirection == 0 and not newBuy and sellSetup
if newBuy or newSell
    positionDirection := newBuy ? 1 : -1
    entryBar := bar_index
    entryTime := time
    activeEntry := newBuy ? proposedLongEntry : proposedShortEntry
    activeStop := newBuy ? proposedLongStop : proposedShortStop
    float initialRisk = math.abs(activeEntry - activeStop)
    activeTarget := activeEntry + initialRisk * positionDirection
    dailyTrades += 1
    entriesInHtfLeg += 1
    entryWeekday := f_weekdayText(dayofweek)
    entryBand := f_timeBand(hour)
    entrySide := newBuy ? "買い" : "売り"
    entry15Aligned := ((newBuy and ltfUp) or (newSell and ltfDown)) ? "同方向" : "逆方向"
    entry5Aligned := ((newBuy and fiveLongAligned) or (newSell and fiveShortAligned)) ? "同方向" : "逆方向"
    entryReason := newBuy ? trendlineBuy ? "下降TL上抜け" : "押し目高値ブレイク" : trendlineSell ? "上昇TL下抜け" : "戻り安値ブレイク"
    entryPhase := entriesInHtfLeg == 1 ? "初動" : "追随"
    entryTradeNumber := str.tostring(dailyTrades) + "回目"
    entryPreviousResult := previousResult
    color signalColor = newBuy ? color.lime : color.red
    label.new(bar_index, activeEntry, (newBuy ? "BUY " : "SELL ") + entryReason, style=newBuy ? label.style_label_up : label.style_label_down, color=signalColor, textcolor=color.white)
    line.new(bar_index, activeEntry, bar_index + i_lineBars, activeEntry, color=color.yellow, width=2)
    line.new(bar_index, activeStop, bar_index + i_lineBars, activeStop, color=color.red, width=2)
    line.new(bar_index, activeTarget, bar_index + i_lineBars, activeTarget, color=color.lime, width=2)

plot(emaFast, "15分足 EMA20", color=color.orange, linewidth=2)
plot(emaSlow, "15分足 EMA50", color=color.blue, linewidth=2)
plot(fallingLine, "下降トレンドライン", color=color.new(color.red, 35), style=plot.style_linebr)
plot(risingLine, "上昇トレンドライン", color=color.new(color.lime, 35), style=plot.style_linebr)
plotshape(newBuy, "BUY entry", shape.triangleup, location.belowbar, color=color.lime, size=size.small, text="BUY")
plotshape(newSell, "SELL entry", shape.triangledown, location.abovebar, color=color.red, size=size.small, text="SELL")

f_scanPack() =>
    float localFast = ta.ema(close, i_fastEma)
    float localSlow = ta.ema(close, i_slowEma)
    float localAtr = ta.atr(14)
    float ph = ta.pivothigh(high, i_ltfPivot, i_ltfPivot)
    float pl = ta.pivotlow(low, i_ltfPivot, i_ltfPivot)
    float lh = ta.valuewhen(not na(ph), ph, 0)
    float phh = ta.valuewhen(not na(ph), ph, 1)
    float ll = ta.valuewhen(not na(pl), pl, 0)
    float pll = ta.valuewhen(not na(pl), pl, 1)
    bool up = localFast > localSlow and close > localFast and lh > phh and ll > pll
    bool down = localFast < localSlow and close < localFast and lh < phh and ll < pll
    float priorHigh = ta.highest(high[1], i_breakLookback)
    float priorLow = ta.lowest(low[1], i_breakLookback)
    bool buyTrigger = ta.lowest(low, i_pullbackLookback) <= localFast + localAtr * i_pullbackAtr and close > priorHigh and close[1] <= priorHigh[1]
    bool sellTrigger = ta.highest(high, i_pullbackLookback) >= localFast - localAtr * i_pullbackAtr and close < priorLow and close[1] >= priorLow[1]
    bool localSession = not na(time(timeframe.period, i_session))
    [up[1], down[1], buyTrigger[1], sellTrigger[1], close[1], localSession[1]]

f_scanPair(string symbol) =>
    [scanHtfLastHigh, scanHtfPreviousHigh, scanHtfLastLow, scanHtfPreviousLow] = request.security(
         symbol, i_higherTf, f_contextPack(i_htfPivot), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
    [scanUp, scanDown, scanBuyTrigger, scanSellTrigger, scanClose, scanSession] = request.security(
         symbol, "15", f_scanPack(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
    bool scanHtfUp = scanHtfLastHigh > scanHtfPreviousHigh and scanHtfLastLow > scanHtfPreviousLow
    bool scanHtfDown = scanHtfLastHigh < scanHtfPreviousHigh and scanHtfLastLow < scanHtfPreviousLow
    bool scanBuy = scanSession and scanHtfUp and scanUp and scanBuyTrigger
    bool scanSell = scanSession and scanHtfDown and scanDown and scanSellTrigger
    int state = scanBuy ? 3 : scanSell ? -3 : scanHtfUp and scanUp ? 2 : scanHtfDown and scanDown ? -2 : scanHtfUp ? 1 : scanHtfDown ? -1 : 0
    [state, scanBuy or scanSell ? scanClose : na, scanClose]

f_scanText(int state) =>
    state == 3 ? "BUY候補" : state == -3 ? "SELL候補" : state == 2 ? "押し目待ち" : state == -2 ? "戻り待ち" : state == 1 ? "上昇監視" : state == -1 ? "下降監視" : "なし"

f_scanColor(int state) =>
    state == 3 ? color.lime : state == -3 ? color.red : state == 2 ? color.new(color.green, 55) : state == -2 ? color.new(color.maroon, 35) : state == 1 ? color.new(color.green, 80) : state == -1 ? color.new(color.red, 80) : color.new(color.gray, 70)

f_scanRow(table target, int row, string symbol, int state, float entry, float lastClose) =>
    table.cell(target, 0, row, f_pairName(symbol), text_color=color.white, bgcolor=color.new(color.black, 10))
    table.cell(target, 1, row, f_scanText(state), text_color=color.white, bgcolor=f_scanColor(state))
    table.cell(target, 2, row, na(entry) ? "-" : str.tostring(entry, "#.#####"), text_color=color.white, bgcolor=color.new(color.black, 10))
    table.cell(target, 3, row, str.tostring(lastClose, "#.#####"), text_color=color.white, bgcolor=color.new(color.black, 10))

[scanState1, scanEntry1, scanClose1] = f_scanPair(i_scanSymbol1)
[scanState2, scanEntry2, scanClose2] = f_scanPair(i_scanSymbol2)
[scanState3, scanEntry3, scanClose3] = f_scanPair(i_scanSymbol3)
[scanState4, scanEntry4, scanClose4] = f_scanPair(i_scanSymbol4)
[scanState5, scanEntry5, scanClose5] = f_scanPair(i_scanSymbol5)
[scanState6, scanEntry6, scanClose6] = f_scanPair(i_scanSymbol6)
[scanState7, scanEntry7, scanClose7] = f_scanPair(i_scanSymbol7)
[scanState8, scanEntry8, scanClose8] = f_scanPair(i_scanSymbol8)
[scanState9, scanEntry9, scanClose9] = f_scanPair(i_scanSymbol9)
[scanState10, scanEntry10, scanClose10] = f_scanPair(i_scanSymbol10)
[scanState11, scanEntry11, scanClose11] = f_scanPair(i_scanSymbol11)
[scanState12, scanEntry12, scanClose12] = f_scanPair(i_scanSymbol12)

var table scanner = table.new(position.bottom_right, 4, 13, border_width=1)
if barstate.islast and i_showScanner
    table.cell(scanner, 0, 0, "通貨", text_color=color.white, bgcolor=color.rgb(49, 27, 146))
    table.cell(scanner, 1, 0, "15分狙い目", text_color=color.white, bgcolor=color.rgb(49, 27, 146))
    table.cell(scanner, 2, 0, "Entry", text_color=color.white, bgcolor=color.rgb(49, 27, 146))
    table.cell(scanner, 3, 0, "現在値", text_color=color.white, bgcolor=color.rgb(49, 27, 146))
    f_scanRow(scanner, 1, i_scanSymbol1, scanState1, scanEntry1, scanClose1)
    f_scanRow(scanner, 2, i_scanSymbol2, scanState2, scanEntry2, scanClose2)
    f_scanRow(scanner, 3, i_scanSymbol3, scanState3, scanEntry3, scanClose3)
    f_scanRow(scanner, 4, i_scanSymbol4, scanState4, scanEntry4, scanClose4)
    f_scanRow(scanner, 5, i_scanSymbol5, scanState5, scanEntry5, scanClose5)
    f_scanRow(scanner, 6, i_scanSymbol6, scanState6, scanEntry6, scanClose6)
    f_scanRow(scanner, 7, i_scanSymbol7, scanState7, scanEntry7, scanClose7)
    f_scanRow(scanner, 8, i_scanSymbol8, scanState8, scanEntry8, scanClose8)
    f_scanRow(scanner, 9, i_scanSymbol9, scanState9, scanEntry9, scanClose9)
    f_scanRow(scanner, 10, i_scanSymbol10, scanState10, scanEntry10, scanClose10)
    f_scanRow(scanner, 11, i_scanSymbol11, scanState11, scanEntry11, scanClose11)
    f_scanRow(scanner, 12, i_scanSymbol12, scanState12, scanEntry12, scanClose12)

var table stats = table.new(position.middle_right, 2, 7,
     bgcolor=cJournalPanel, frame_color=cJournalBorder, frame_width=1,
     border_color=color.rgb(71, 85, 105), border_width=1)
if barstate.islast and (i_showStats or not isFifteenMinute)
    int closedTrades = wins + losses + withdrawals
    float winRate = wins + losses > 0 ? wins * 100.0 / (wins + losses) : na
    color trendColor = htfTrend == 1 ? color.aqua : htfTrend == -1 ? color.rgb(255, 152, 0) : cJournalMuted
    color winRateColor = na(winRate) ? cJournalText : winRate >= 50 ? color.lime : winRate >= 45 ? color.yellow : color.rgb(255, 82, 82)
    table.cell(stats, 0, 0, "よすが式 15m", text_color=color.white, bgcolor=color.rgb(49, 46, 129), text_size=size.normal, text_halign=text.align_left)
    table.cell(stats, 1, 0, "研究用", text_color=color.white, bgcolor=color.rgb(230, 81, 0), text_size=size.normal, text_halign=text.align_center)
    f_journalKey(stats, 1, "時間足")
    f_journalValue(stats, 1, isFifteenMinute ? "15分足 OK" : "15分足に変更", isFifteenMinute ? color.lime : color.rgb(255, 82, 82))
    f_journalKey(stats, 2, "4H方向")
    f_journalValue(stats, 2, htfTrend == 1 ? "上昇" : htfTrend == -1 ? "下降" : "レンジ", trendColor)
    f_journalKey(stats, 3, "勝 / 負 / 撤退")
    f_journalValue(stats, 3, str.tostring(wins) + " / " + str.tostring(losses) + " / " + str.tostring(withdrawals), cJournalText)
    f_journalKey(stats, 4, "勝率")
    f_journalValue(stats, 4, na(winRate) ? "-" : str.tostring(winRate, "#.0") + "%", winRateColor)
    f_journalKey(stats, 5, "総決済")
    f_journalValue(stats, 5, str.tostring(closedTrades), cJournalText)
    f_journalKey(stats, 6, "RR")
    f_journalValue(stats, 6, "1:1固定", color.lime)

var table journal = table.new(position.middle_left, 2, 15,
     bgcolor=cJournalPanel, frame_color=cJournalBorder, frame_width=1,
     border_color=color.rgb(71, 85, 105), border_width=1)
if barstate.islast and i_showJournal
    color resultColor = lastResult == "勝ち" ? color.lime : lastResult == "負け" ? color.rgb(255, 82, 82) : color.rgb(255, 193, 7)
    color evaluationColor = lastEvaluation == "A" ? color.lime : lastEvaluation == "B" ? color.yellow : lastEvaluation == "C" ? color.rgb(255, 82, 82) : cJournalText
    color sideColor = lastSide == "買い" ? color.aqua : lastSide == "売り" ? color.rgb(255, 152, 0) : cJournalText
    color alignment15Color = last15Aligned == "同方向" ? color.lime : color.rgb(255, 152, 0)
    color alignment5Color = last5Aligned == "同方向" ? color.lime : color.rgb(255, 152, 0)
    color previousColor = lastPreviousResult == "勝ち" ? color.lime : lastPreviousResult == "負け" ? color.rgb(255, 82, 82) : color.yellow
    string holdText = lastHoldMinutes == "-" ? "-" : lastHoldMinutes + " 分"
    string pipsText = lastPips == "-" ? "-" : lastPips + " pips"
    table.cell(journal, 0, 0, "直近トレード", text_color=color.white, bgcolor=color.rgb(49, 46, 129), text_size=size.normal, text_halign=text.align_left)
    table.cell(journal, 1, 0, lastResult, text_color=color.white, bgcolor=lastResult == "勝ち" ? color.rgb(0, 121, 107) : lastResult == "負け" ? color.rgb(183, 28, 28) : color.rgb(230, 81, 0), text_size=size.normal, text_halign=text.align_center)
    f_journalKey(journal, 1, "曜日")
    f_journalValue(journal, 1, lastWeekday, cJournalText)
    f_journalKey(journal, 2, "時間帯")
    f_journalValue(journal, 2, lastBand, cJournalText)
    f_journalKey(journal, 3, "保有分")
    f_journalValue(journal, 3, holdText, cJournalText)
    f_journalKey(journal, 4, "買い・売り")
    f_journalValue(journal, 4, lastSide, sideColor)
    f_journalKey(journal, 5, "15分足方向")
    f_journalValue(journal, 5, last15Aligned, alignment15Color)
    f_journalKey(journal, 6, "5分足方向")
    f_journalValue(journal, 6, last5Aligned, alignment5Color)
    f_journalKey(journal, 7, "トレード評価")
    f_journalValue(journal, 7, lastEvaluation, evaluationColor)
    f_journalKey(journal, 8, "獲得pips")
    f_journalValue(journal, 8, pipsText, resultColor)
    f_journalKey(journal, 9, "結果")
    f_journalValue(journal, 9, lastResult, resultColor)
    f_journalKey(journal, 10, "初動・追随")
    f_journalValue(journal, 10, lastPhase, lastPhase == "初動" ? color.aqua : color.yellow)
    f_journalKey(journal, 11, "当日取引")
    f_journalValue(journal, 11, lastTradeNumber, cJournalText)
    f_journalKey(journal, 12, "1回前の結果")
    f_journalValue(journal, 12, lastPreviousResult, previousColor)
    f_journalKey(journal, 13, "取引種別")
    f_journalValue(journal, 13, lastStyle, cJournalText)
    f_journalKey(journal, 14, "エントリー理由")
    f_journalValue(journal, 14, lastReason, color.rgb(125, 211, 252))

alertcondition(newBuy, "よすが式15分 BUY", "4H上昇方向へ15分足BUY")
alertcondition(newSell, "よすが式15分 SELL", "4H下降方向へ15分足SELL")
bool scannerNewChance = (math.abs(scanState1) == 3 and math.abs(scanState1[1]) != 3) or (math.abs(scanState2) == 3 and math.abs(scanState2[1]) != 3) or (math.abs(scanState3) == 3 and math.abs(scanState3[1]) != 3) or (math.abs(scanState4) == 3 and math.abs(scanState4[1]) != 3) or (math.abs(scanState5) == 3 and math.abs(scanState5[1]) != 3) or (math.abs(scanState6) == 3 and math.abs(scanState6[1]) != 3) or (math.abs(scanState7) == 3 and math.abs(scanState7[1]) != 3) or (math.abs(scanState8) == 3 and math.abs(scanState8[1]) != 3) or (math.abs(scanState9) == 3 and math.abs(scanState9[1]) != 3) or (math.abs(scanState10) == 3 and math.abs(scanState10[1]) != 3) or (math.abs(scanState11) == 3 and math.abs(scanState11[1]) != 3) or (math.abs(scanState12) == 3 and math.abs(scanState12[1]) != 3)
alertcondition(scannerNewChance, "よすが式15分 通貨ペア狙い目", "4H方向へ15分足の新しい候補が出ました")
