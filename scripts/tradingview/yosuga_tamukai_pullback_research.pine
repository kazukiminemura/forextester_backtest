//@version=5
indicator("Yosuga x Tamukai Pullback Research", overlay=true, shorttitle="YT_Pullback_RR1", max_labels_count=500, max_lines_count=500)

gpTrend = "【確定4時間足方向】"
htfTimeframe = input.timeframe("240", "上位足", group=gpTrend)
htfMaLength = input.int(20, "上位足SMA期間", minval=2, group=gpTrend)

gpEntry = "【15分足 押し目・戻り】"
entryMaLength = input.int(20, "押し目・戻りSMA期間", minval=2, group=gpEntry)
setupWaitBars = input.int(4, "接触後の再加速待機本数", minval=1, maxval=16, group=gpEntry)
closeLocationThreshold = input.float(0.65, "反転足の終値位置", minval=0.5, maxval=0.9, step=0.05, group=gpEntry)
requireEntryMaSlope = input.bool(true, "15分足SMAの傾き一致を必須にする", group=gpEntry)

gpRisk = "【RR1・建値撤退】"
atrLength = input.int(14, "ATR期間", minval=1, group=gpRisk)
structureBufferAtr = input.float(0.1, "構造SLのATRバッファ", minval=0.0, step=0.05, group=gpRisk)
breakevenTriggerR = input.float(0.5, "建値移動を有効にするR", minval=0.1, maxval=0.9, step=0.05, group=gpRisk)
roundTripCostPct = input.float(0.01, "往復コスト (%)", minval=0.0, step=0.01, group=gpRisk)

bool isFifteenMinuteChart = timeframe.isminutes and timeframe.multiplier == 15
float entryMa = ta.sma(close, entryMaLength)
float atrValue = ta.atr(atrLength)
float completedHtfMa = request.security(syminfo.tickerid, htfTimeframe, ta.sma(close, htfMaLength)[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
float previousCompletedHtfMa = request.security(syminfo.tickerid, htfTimeframe, ta.sma(close, htfMaLength)[2], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
bool htfLong = completedHtfMa > previousCompletedHtfMa
bool htfShort = completedHtfMa < previousCompletedHtfMa

plot(entryMa, "15分足 SMA20", color=ta.rising(entryMa, 1) ? color.blue : color.red, linewidth=2)

var int armedDirection = 0
var int armedBar = na
var float armedExtreme = na

var int tradeDirection = 0
var int entryBar = na
var float entryPrice = na
var float stopPrice = na
var float targetPrice = na
var float breakevenTriggerPrice = na
var bool breakevenActive = false

var int closedTrades = 0
var int wins = 0
var int losses = 0
var int breakevens = 0
var float totalReturnPct = 0.0
var float grossProfitPct = 0.0
var float grossLossPct = 0.0

var line activeEntryLine = na
var line activeTargetLine = na
var line activeStopLine = na
var label timeframeWarning = na

bool longEntrySignal = false
bool shortEntrySignal = false

// 既存ポジションの決済を先に判定します。
if tradeDirection != 0 and bar_index > entryBar
    float effectiveStop = breakevenActive ? entryPrice : stopPrice
    bool stopHit = tradeDirection == 1 ? low <= effectiveStop : high >= effectiveStop
    bool targetHit = tradeDirection == 1 ? high >= targetPrice : low <= targetPrice
    bool triggerHit = tradeDirection == 1 ? high >= breakevenTriggerPrice : low <= breakevenTriggerPrice
    float exitPrice = na
    string exitName = ""
    color exitColor = color.gray
    if stopHit
        exitPrice := effectiveStop
        exitName := breakevenActive ? "建値撤退" : "損切"
        exitColor := breakevenActive ? color.gray : color.red
    else if targetHit
        exitPrice := targetPrice
        exitName := "利確 1R"
        exitColor := color.green
    else if triggerHit
        // 同一足内の有利な値動き順を仮定せず、次足から建値を有効にします。
        breakevenActive := true
        line.set_y1(activeStopLine, entryPrice)
        line.set_y2(activeStopLine, entryPrice)
        line.set_color(activeStopLine, color.gray)

    if not na(exitPrice)
        float tradeReturnPct = tradeDirection * (exitPrice - entryPrice) / entryPrice * 100.0 - roundTripCostPct
        string returnPrefix = tradeReturnPct > 0 ? "+" : ""
        string directionName = tradeDirection == 1 ? "ロング" : "ショート"
        label.new(bar_index, exitPrice, directionName + " " + exitName + "\n決済: " + str.tostring(exitPrice, format.mintick) + "\n損益: " + returnPrefix + str.tostring(tradeReturnPct, "#.##") + "%", xloc=xloc.bar_index, yloc=yloc.price, style=tradeDirection == 1 ? label.style_label_down : label.style_label_up, color=exitColor, textcolor=color.white, size=size.small)
        closedTrades := closedTrades + 1
        totalReturnPct := totalReturnPct + tradeReturnPct
        if exitName == "建値撤退"
            breakevens := breakevens + 1
            grossLossPct := grossLossPct + math.abs(tradeReturnPct)
        else if tradeReturnPct > 0
            wins := wins + 1
            grossProfitPct := grossProfitPct + tradeReturnPct
        else
            losses := losses + 1
            grossLossPct := grossLossPct + math.abs(tradeReturnPct)
        line.set_x2(activeEntryLine, bar_index)
        line.set_x2(activeTargetLine, bar_index)
        line.set_x2(activeStopLine, bar_index)
        tradeDirection := 0
        entryBar := na
        entryPrice := na
        stopPrice := na
        targetPrice := na
        breakevenTriggerPrice := na
        breakevenActive := false
        armedDirection := 0
        armedBar := na
        armedExtreme := na

if tradeDirection != 0
    line.set_x2(activeEntryLine, bar_index)
    line.set_x2(activeTargetLine, bar_index)
    line.set_x2(activeStopLine, bar_index)

// 押し目・戻り待機後の再加速を判定します。
if isFifteenMinuteChart and tradeDirection == 0 and not na(entryMa) and not na(atrValue)
    if armedDirection != 0
        int setupAge = bar_index - armedBar
        bool directionStillValid = armedDirection == 1 ? htfLong : htfShort
        if setupAge > setupWaitBars or not directionStillValid
            armedDirection := 0
            armedBar := na
            armedExtreme := na
        else if setupAge >= 1
            armedExtreme := armedDirection == 1 ? math.min(armedExtreme, low) : math.max(armedExtreme, high)
            bool maSlopeOk = not requireEntryMaSlope or (armedDirection == 1 ? entryMa > entryMa[1] : entryMa < entryMa[1])
            bool reaccelerated = armedDirection == 1 ? close > high[1] : close < low[1]
            bool correctMaSide = armedDirection == 1 ? close > entryMa : close < entryMa
            if maSlopeOk and reaccelerated and correctMaSide
                float proposedStop = armedExtreme - armedDirection * atrValue * structureBufferAtr
                float riskDistance = armedDirection * (close - proposedStop)
                if riskDistance > syminfo.mintick
                    tradeDirection := armedDirection
                    entryBar := bar_index
                    entryPrice := close
                    stopPrice := proposedStop
                    targetPrice := entryPrice + tradeDirection * riskDistance
                    breakevenTriggerPrice := entryPrice + tradeDirection * riskDistance * breakevenTriggerR
                    breakevenActive := false
                    activeEntryLine := line.new(bar_index, entryPrice, bar_index, entryPrice, color=color.yellow, width=2)
                    activeTargetLine := line.new(bar_index, targetPrice, bar_index, targetPrice, color=color.lime, width=2)
                    activeStopLine := line.new(bar_index, stopPrice, bar_index, stopPrice, color=color.red, width=2)
                    string entryName = tradeDirection == 1 ? "ロング Entry" : "ショート Entry"
                    label.new(bar_index, entryPrice, entryName + "\nEntry: " + str.tostring(entryPrice, format.mintick) + "\nTP: " + str.tostring(targetPrice, format.mintick) + "\nSL: " + str.tostring(stopPrice, format.mintick), xloc=xloc.bar_index, yloc=yloc.price, style=tradeDirection == 1 ? label.style_label_up : label.style_label_down, color=tradeDirection == 1 ? color.blue : color.orange, textcolor=color.white, size=size.small)
                    longEntrySignal := tradeDirection == 1
                    shortEntrySignal := tradeDirection == -1
                    armedDirection := 0
                    armedBar := na
                    armedExtreme := na

    if armedDirection == 0 and tradeDirection == 0 and not na(entryMa[1])
        float candleRange = high - low
        float longCloseLocation = candleRange > 0 ? (close - low) / candleRange : 0.5
        float shortCloseLocation = 1.0 - longCloseLocation
        bool longTouch = htfLong and low[1] > entryMa[1] and low <= entryMa and close >= entryMa and longCloseLocation >= closeLocationThreshold
        bool shortTouch = htfShort and high[1] < entryMa[1] and high >= entryMa and close <= entryMa and shortCloseLocation >= closeLocationThreshold
        if longTouch
            armedDirection := 1
            armedBar := bar_index
            armedExtreme := low
        else if shortTouch
            armedDirection := -1
            armedBar := bar_index
            armedExtreme := high

plotshape(longEntrySignal, title="押し目買い", style=shape.triangleup, location=location.belowbar, color=color.blue, size=size.normal, text="BUY", textcolor=color.white)
plotshape(shortEntrySignal, title="戻り売り", style=shape.triangledown, location=location.abovebar, color=color.orange, size=size.normal, text="SELL", textcolor=color.white)

float winRate = closedTrades > 0 ? wins * 100.0 / closedTrades : na
float expectancyPct = closedTrades > 0 ? totalReturnPct / closedTrades : na
float profitFactor = grossLossPct > 0 ? grossProfitPct / grossLossPct : na

fPct(float value) =>
    na(value) ? "--" : str.tostring(value, "#.##") + "%"

fNum(float value) =>
    na(value) ? "--" : str.tostring(value, "#.##")

var table stats = table.new(position.bottom_right, 2, 9, bgcolor=color.new(color.black, 5), border_width=2, frame_width=2, frame_color=color.orange)
if barstate.islast
    color header = color.rgb(25, 95, 165)
    color keyBg = color.rgb(45, 50, 60)
    color valueBg = color.rgb(15, 18, 24)
    table.cell(stats, 0, 0, "Yosuga × Tamukai", bgcolor=header, text_color=color.white)
    table.cell(stats, 1, 0, "押し目・戻り研究", bgcolor=header, text_color=color.white)
    table.cell(stats, 0, 1, "4H方向", bgcolor=keyBg, text_color=color.white)
    table.cell(stats, 1, 1, htfLong ? "上昇" : htfShort ? "下降" : "横ばい", bgcolor=valueBg, text_color=htfLong ? color.lime : htfShort ? color.red : color.silver)
    table.cell(stats, 0, 2, "セットアップ", bgcolor=keyBg, text_color=color.white)
    table.cell(stats, 1, 2, armedDirection == 1 ? "押し目待機" : armedDirection == -1 ? "戻り待機" : tradeDirection != 0 ? "保有中" : "待機", bgcolor=valueBg, text_color=color.white)
    table.cell(stats, 0, 3, "決済済み", bgcolor=keyBg, text_color=color.white)
    table.cell(stats, 1, 3, str.tostring(closedTrades), bgcolor=valueBg, text_color=color.white)
    table.cell(stats, 0, 4, "利確 / 損切 / 建値", bgcolor=keyBg, text_color=color.white)
    table.cell(stats, 1, 4, str.tostring(wins) + " / " + str.tostring(losses) + " / " + str.tostring(breakevens), bgcolor=valueBg, text_color=color.white)
    table.cell(stats, 0, 5, "勝率", bgcolor=keyBg, text_color=color.white)
    table.cell(stats, 1, 5, fPct(winRate), bgcolor=valueBg, text_color=na(winRate) ? color.silver : winRate >= 50 ? color.lime : color.red)
    table.cell(stats, 0, 6, "期待値 / 取引", bgcolor=keyBg, text_color=color.white)
    table.cell(stats, 1, 6, fPct(expectancyPct), bgcolor=valueBg, text_color=na(expectancyPct) ? color.silver : expectancyPct > 0 ? color.lime : color.red)
    table.cell(stats, 0, 7, "PF", bgcolor=keyBg, text_color=color.white)
    table.cell(stats, 1, 7, fNum(profitFactor), bgcolor=valueBg, text_color=na(profitFactor) ? color.silver : profitFactor >= 1 ? color.lime : color.red)
    table.cell(stats, 0, 8, "累計損益", bgcolor=keyBg, text_color=color.white)
    table.cell(stats, 1, 8, fPct(totalReturnPct), bgcolor=valueBg, text_color=totalReturnPct > 0 ? color.lime : totalReturnPct < 0 ? color.red : color.white)

if barstate.islast
    if not isFifteenMinuteChart
        if na(timeframeWarning)
            timeframeWarning := label.new(bar_index, high, "15分足チャート専用", style=label.style_label_down, color=color.red, textcolor=color.white)
        else
            label.set_xy(timeframeWarning, bar_index, high)
    else if not na(timeframeWarning)
        label.delete(timeframeWarning)
        timeframeWarning := na
