//@version=6
indicator("研究未採用 Patrick逆方向 / 費用10%以下 [仮想約定]", overlay=true, max_lines_count=500, max_labels_count=500, dynamic_requests=true)

// Research draft, explicitly requested by user; NOT approved for live trading.
// Implements frozen Python costfilter threshold10: original signal, reverse execution,
// swapped absolute TP/SL levels, conservative cost <= 10% of reverse SL distance.
// FT training2017-2019 failed profitability gates; later candidate periods NOT evaluated.
// TV_UNVERIFIED until actual TradingView compile/behaviour evidence is recorded.
// Custom confirmed-M1 virtual simulator, NOT Strategy Tester or an order connection.
const int MINUTE = 60000
const int H4 = 14400000
const int DAY = 86400000
const int WEEK = 604800000
const int JST = 32400000
const int ATR_PERIOD = 20
const int VP_BINS = 100
const float VA_FRACTION = 0.70
const float IMPULSE_ATR = 0.5
const float RANGE_ATR = 4.0
const float LINE_ATR = 4.0
const float NEAR_ATR = 5.0
const float STOP_ATR = 0.25
const int H4_LOOKBACK_MS = 7 * DAY
const float MIN_RISK_COST = 10.0

const int SCAN_UNDECIDED = 0
const int SCAN_CANDIDATE = 1
const int SCAN_FILLED = 2
const int SCAN_CANCELED = 3
const int SCAN_NONE = 4
const int SCAN_UNREADY = 5
const int SCAN_HOLDING = 6
const int SCAN_TP = 7
const int SCAN_SL = 8
const int SCAN_MOVE_SHORT = 9

