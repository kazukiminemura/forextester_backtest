string symbol2 = input.symbol("OANDA:GBPUSD", "通貨2", group="監視通貨")
string symbol3 = input.symbol("OANDA:USDJPY", "通貨3", group="監視通貨")
string symbol4 = input.symbol("OANDA:EURJPY", "通貨4", group="監視通貨")
string symbol5 = input.symbol("OANDA:GBPJPY", "通貨5", group="監視通貨")
string symbol6 = input.symbol("OANDA:NZDJPY", "通貨6", group="監視通貨")
string symbol7 = input.symbol("OANDA:CADJPY", "通貨7", group="監視通貨")
string symbol8 = input.symbol("OANDA:AUDJPY", "通貨8", group="監視通貨")
string symbol9 = input.symbol("OANDA:XAUUSD", "ゴールド", group="監視通貨")
float goldCostUnit = input.float(0.20, "XAUUSDの費用単位（USD）", minval=0.01, step=0.01, tooltip="仮定値。通常のスプレッドはこの値、判定用推定費用は1.8倍。厳しめではそれぞれ2倍と5.4倍。取引先の条件に合わせて調整。")
int tableTextSize = input.int(15, "一覧の文字サイズ", minval=11, maxval=22, group="表示")

string costMode = input.string("通常仮定", "費用シナリオ", options=["通常仮定", "厳しめ仮定"])
int beginTime = input.time(timestamp("01 Jan 2017 00:00 +0000"), "仮想ENTRY開始 UTC")
int endTime = input.time(timestamp("01 Jan 2099 00:00 +0000"), "仮想ENTRY終了 UTC")
int keepTrades = input.int(50, "保持する過去のEntry/TP/SL件数", minval=1, maxval=120)
bool showProfiles = input.bool(true, "前週・前々週のVAH/VAL")
bool showSetupContext = input.bool(false, "選定したH4レンジ・参照VAH/VALの詳細", group="表示")
bool showHistoricalLabels = input.bool(false, "過去の価格ラベルを表示", group="過去（決済済み）")
