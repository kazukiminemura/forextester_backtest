int scannerHistory = input.int(32000, "一覧の取得1分足数", minval=30000, maxval=100000, step=1000, group="監視通貨", tooltip="一覧の初期化に使う銘柄ごとの履歴。出来高帯に完成2週が必要です。増やすほど読み込み負荷が上がります。")
